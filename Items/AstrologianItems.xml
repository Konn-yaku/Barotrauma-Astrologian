<?xml version="1.0" encoding="utf-8"?>
<!--
  占星术士 · 专属装备

  ── 天球仪 mcj_astrolabe ──
  占星术士的常驻武器，由第三栏（mcj_path_astrolabe）第 1 档天赋发放。

    · smallitem  —— 能像仪式剑那样收进物品栏。
                    正因为能收起来，"取出才生效"才有意义。
    · 手持       —— Holdable slots="Any,RightHand,LeftHand"，既能握在手上开火，
                    也能收进物品栏（只写 RightHand+LeftHand 就会被锁死在手上）。
    · 远程攻击   —— hitscan 星光射线（即时光束，没有飞行中的弹丸）。

  ── 【不消耗弹药】的实现 ──
  思路取自原版小丑的香蕉皮发射器：开火时现场"变"出一发弹药，打完自清。

      <StatusEffect type="OnUse" target="This">
        <SpawnItem identifier="mcj_starshot" spawnposition="ThisInventory" count="1" />
      </StatusEffect>
      <RequiredItems items="mcj_starshot" type="Contained" />
      ...
      <ItemContainer capacity="1" maxstacksize="1" hideitems="true">
        <Containable items="mcj_starshot" />           ( 必须真的接受它 )
        <StatusEffect type="OnSpawn" target="this">    ( 出生先预装一发 )
          <SpawnItem identifier="mcj_starshot" spawnposition="ThisInventory" count="1" />
        </StatusEffect>
      </ItemContainer>

  ⚠️ 踩过的坑（务必别再犯）：
    1. 容器不能写成 capacity="0" + Containable items="none"
       —— 弹丸永远塞不进去，RequiredItems 必然失败，游戏只会一直提示"弹药耗尽"。
    2. Holdable 的 slots 必须包含 Any（用 "Any,RightHand,LeftHand"）。
       只写 "RightHand+LeftHand" 的话物品会被锁死在手上，塞不进物品栏。
       对照原版：左轮 = Any,RightHand,LeftHand（可收纳）
                 步枪 = RightHand+LeftHand（只能手持）

  ── 贴图说明 ──
  占位贴图复用原版材料"fulgurium"的发光晶体图，看起来最接近一颗魔法球。
  以后想换外观，只改 <Sprite> / <InventoryIcon> 的 texture + sourcerect 两行即可。

  ── 地星 mcj_earthlystar ──
  第三栏第 2 档发放的「预先布置」装置。完整的机制说明写在它自己的注释里。
-->
<Items>

  <!-- ============================================================
       天球仪
       ============================================================ -->
  <Item name="" identifier="mcj_astrolabe" category="Weapon"
        tags="smallitem,weapon,gunsmith,mountableweapon"
        cargocontaineridentifier="metalcrate" allowasextracargo="true" scale="0.5"
        impactsoundtag="impact_metal_light">

    <Price baseprice="220" sold="false" />

    <Deconstruct time="15">
      <Item identifier="fulgurium" />
      <Item identifier="plastic" />
    </Deconstruct>

    <!-- 允许自己打造一把，免得弄丢后拿不回来（不加 requiresrecipe = 默认可制造） -->
    <Fabricate suitablefabricators="fabricator" requiredtime="30">
      <RequiredSkill identifier="medical" level="30" />
      <RequiredItem identifier="fulgurium" />
      <RequiredItem identifier="plastic" amount="2" />
    </Fabricate>

    <InventoryIcon texture="Content/Items/Alien/AlienMaterials.png" sourcerect="186,351,59,67" origin="0.5,0.5" />
    <Sprite texture="Content/Items/Alien/AlienMaterials.png" sourcerect="186,351,59,67" depth="0.55" origin="0.5,0.5" />
    <Body radius="20" density="15" />

    <!-- slots 必须包含 Any，否则物品只能待在手上、塞不进物品栏。
         对照原版：左轮 = "Any,RightHand,LeftHand"（可收纳）
                   步枪 = "RightHand+LeftHand"（只能手持） -->
    <!-- 握持姿势：照左轮（原版小型远程武器）的最小写法。
         handle1 是唯一的握点，放在球体偏下位置，让手搭在球底。
         觉得别扭就调这三个数：holdpos（整体偏移）/ aimpos（瞄准偏移）/ handle1（握点）。 -->
    <Holdable slots="Any,RightHand,LeftHand" controlpose="true" holdpos="0,-22" aimpos="55,0"
              handle1="-18,-14" holdangle="0" msg="ItemMsgPickUpSelect" />

    <!-- reload 0.8 = 快速裂变加速器（0.5）的一半攻速；无蓄力时间，扣扳机即射 -->
    <RangedWeapon reload="0.8" holdtrigger="true" barrelpos="30,0" spread="1" unskilledspread="10"
                  combatpriority="60" drawhudwhenequipped="true" crosshairscale="0.2"
                  suitableprojectiles="mcj_starshot">

      <Crosshair texture="Content/Items/Weapons/Crosshairs.png" sourcerect="0,256,256,256" />
      <CrosshairPointer texture="Content/Items/Weapons/Crosshairs.png" sourcerect="256,256,256,256" />

      <Sound file="Content/Items/Alien/AlienTurret1.ogg" type="OnUse" range="1000" selectionmode="Random" />
      <Sound file="Content/Items/Alien/AlienTurret2.ogg" type="OnUse" range="1000" />

      <!-- 枪口特效：照拷贝快速裂变加速器 -->
      <ParticleEmitter particle="FlareBubbles" scalemin="1.4" scalemax="1.8" particleamount="14"
                       anglemin="0" anglemax="360" velocitymin="0" velocitymax="50" />
      <ParticleEmitter particle="GlowDot" scalemin="4.0" scalemax="4.0" particleamount="20"
                       anglemin="0" anglemax="360" velocitymin="0" velocitymax="0"
                       colormultiplier="180,200,255,255" />

      <!-- 每次都现场生成一发星辉弹。
           （第一次不用等这行 —— 下面的 ItemContainer 会在物品创建时预装一发） -->
      <StatusEffect type="OnUse" target="This">
        <SpawnItem identifier="mcj_starshot" spawnposition="ThisInventory" count="1" />
      </StatusEffect>

      <!-- 【弹药提示】不写 msg！写在的话每枪都会弹一次“弹药耗尽”。
           弹丸是开火瞬间现场生成的，检查与生成之间总有一丝时间差，
           原版小丑的香蕉皮发射器也是这么绕开的（它的 RequiredItems 同样不写 msg）。 -->
      <RequiredItems items="mcj_starshot" type="Contained" />
    </RangedWeapon>

    <!-- 【关键】容器必须真的接受星辉弹，否则 RequiredItems 永远不通过，只会报"弹药耗尽"。
         OnSpawn 预装一发：保证第一枪就能打，不用等 OnUse 补货。
         写法照抄原版 toolbelt 的 OnSpawn + ThisInventory。 -->
    <ItemContainer capacity="1" maxstacksize="1" hideitems="true">
      <Containable items="mcj_starshot" />
      <StatusEffect type="OnSpawn" target="this">
        <SpawnItem identifier="mcj_starshot" spawnposition="ThisInventory" count="1" />
      </StatusEffect>
    </ItemContainer>

  </Item>

  <!-- ============================================================
       星辉弹（隐藏物品，玩家看不到也拿不到）
       每次开火由天球仪现场生成，发射后立刻自我删除。
       伤害 = 快速裂变加速器的一半；并把辐射换成了「焚灼」的烧伤。
       ============================================================ -->
  <Item name="" identifier="mcj_starshot" category="Weapon"
        scale="0.5" hideinmenus="true" sonarsize="2">

    <Sprite texture="Content/Items/Alien/AlienMaterials.png" sourcerect="186,351,59,67" depth="0.55" origin="0.5,0.5" />
    <Body width="10" height="10" density="5" />
    <Holdable slots="RightHand+LeftHand" aimable="false" />

    <Projectile characterusable="false" hitscan="true" removeonhit="true">

      <!-- 弹道动画：照拷贝快速裂变加速器的写法。
           tracernucleargun 会沿整条射线画出一道轨迹（这才是“一个东西飞出去”的观感），
           FlareBubbles 的 emitacrossrayinterval 则在水下沿射线吐出一串气泡。 -->
      <ParticleEmitter particle="tracernucleargun" particleamount="1" velocitymin="0" velocitymax="0" scalemultiplier="1,0.75" />
      <ParticleEmitter particle="FlareBubbles" emitacrossrayinterval="50" />

      <!-- 原版快速裂变加速器：structuredamage 35 / itemdamage 35 / explosiondamage 50
           / radiation 25 / stun 0.5 / severlimbs 0.5。这里全部减半，辐射换成烧伤。 -->
      <Attack structuredamage="17" targetforce="5" itemdamage="17"
              severlimbsprobability="0.25" penetration="0.5">
        <Affliction identifier="explosiondamage" strength="25" />
        <Affliction identifier="burn" strength="12" />
      </Attack>

      <!-- 命中特效：同样照拷贝快速裂变加速器 -->
      <StatusEffect type="OnImpact" target="UseTarget">
        <ParticleEmitter particle="muzzleflashnucleargun" anglemin="0" anglemax="360" particleamount="10"
                         velocitymin="0" scalemin="0.5" scalemax="0.8" scalemultiplier="0.75,0.75" />
        <ParticleEmitter particle="weldspark" particleamount="5" anglemin="0" anglemax="360"
                         velocitymin="300" velocitymax="350" scalemin="1.5" scalemax="1.9"
                         drawontop="true" colormultiplier="150,200,255,180" />
        <ParticleEmitter particle="FlareBubbles" particleamount="3" anglemin="0" anglemax="360"
                         velocitymin="0" velocitymax="50" />
      </StatusEffect>

      <!-- 命中点的小范围灼烧 -->
      <StatusEffect type="OnImpact" target="UseTarget" disabledeltatime="true">
        <Explosion range="60.0" structuredamage="0" itemdamage="0" force="2.0"
                   flames="false" smoke="false" sparks="false" underwaterbubble="false"
                   flashcolor="180,200,255,255" penetration="1">
          <Affliction identifier="burn" strength="8" />
        </Explosion>
      </StatusEffect>

      <!-- 离开容器（= 已发射）后自我清理，不留残余物品 -->
      <StatusEffect type="OnNotContained" target="This">
        <Remove />
      </StatusEffect>

    </Projectile>
  </Item>

  <!-- ============================================================
       地星 mcj_earthlystar
       一次性、可预先放置的船体修复装置。由第三栏第 2 档天赋发放。

       【流程】放下 → 10 秒蓄力 → 舱室进水 → 修补船体 → 自己消失

       ── 为什么用负数 structuredamage 的爆炸来「修船」──
       这是原版自己的做法。机械师大招道具「固化泡沫手榴弹」：
           <Explosion range="1000" structuredamage="-200" ... />
       正值是炸毁船体，负值就是修回船体。这是原版唯一的「自动修补」原语。
       （注：给舰体挂 StatusEffect 修不了船——target="Hull" 只认 oxygen 一个属性，
         原版三处用法全是氧气，没有耐久类属性。）

       ── 为什么用 InWater 当作「船壳受损」的判定 ──
       游戏里没有可供外部物品捕捉的「船体受损」事件。
       但「进水」是可靠的代理：船体破了才会进水。
       而 InWater 用在物品上确实有效——原版接线盒 / 反应堆 / 电池都靠它判定泡水：
           poweritems.xml: <StatusEffect type="InWater" target="This" condition="-0.25" />

       ── 为什么用 Throwable ──
       照原版液态氧石。它就是「掉在地上持续影响所在舱室」的唯一原版先例：
           alienitems.xml: <StatusEffect type="OnNotContained" target="Hull" oxygen="5000.0" />

       【数值对照】
         焊枪（玩家手持，持续）      structurefixamount="2.0"   range 150
         固化泡沫手榴弹（原版大招）  一次性 structuredamage="-200" range 1000
         地星（本模组）              一次性 structuredamage="-40"  range 250
       范围与数值都远小于原版大招；一次只能封一个舱室的破口。

       【强度控制】地星是一次性的，用一次就没了，所以不存在反复刷的问题。
       要再造一颗得在制造台花 30 秒 + 1 精炼钍 + 2 塑胶。
       ============================================================ -->
  <Item name="" identifier="mcj_earthlystar" category="Equipment"
        tags="smallitem,earthlystar"
        cargocontaineridentifier="metalcrate" allowasextracargo="true" scale="0.5"
        impactsoundtag="impact_metal_light">

    <Price baseprice="200" sold="false" />

    <Deconstruct time="15">
      <Item identifier="fulgurium" />
      <Item identifier="plastic" />
    </Deconstruct>

    <!-- requiresrecipe="true" = 必须点出「地星」天赋才会出现在制造台里。
         对照原版：固化泡沫手榴弹也是 requiresrecipe + 天赋里 AddedRecipe。 -->
    <Fabricate suitablefabricators="fabricator" requiredtime="30" requiresrecipe="true">
      <RequiredSkill identifier="medical" level="30" />
      <RequiredItem identifier="fulgurium" />
      <RequiredItem identifier="plastic" amount="2" />
    </Fabricate>

    <InventoryIcon texture="Content/Items/Alien/AlienMaterials.png" sourcerect="18,436,58,69" origin="0.5,0.5" />
    <Sprite texture="Content/Items/Alien/AlienMaterials.png" sourcerect="18,436,58,69" depth="0.55" origin="0.5,0.5" />
    <Body radius="18" density="15" />

    <Throwable characterusable="false" slots="Any,RightHand,LeftHand" handle1="0,-5"
               throwforce="3.5" aimpos="35,-10" msg="ItemMsgPickUpSelect">

      <!-- 【核心】放下 10 秒后开始待机，之后每秒检查一次是否被淹。
           delay + interval 可以共存（对照原版 explosives.xml:351 的闪光弹）。 -->
      <StatusEffect type="OnNotContained" target="This" delay="10.0" interval="1.0">
        <Conditional InWater="true" />

        <!-- 绽放特效（粒子名沿用天球仪里已验证可用的那几个） -->
        <Sound file="Content/Items/Alien/AlienTurret1.ogg" range="1500" />
        <ParticleEmitter particle="FlareBubbles" anglemin="0" anglemax="360"
                         velocitymin="0" velocitymax="120" particleamount="30"
                         scalemin="2.0" scalemax="3.0" />
        <ParticleEmitter particle="GlowDot" anglemin="0" anglemax="360"
                         velocitymin="0" velocitymax="0" particleamount="24"
                         scalemin="5.0" scalemax="5.0" colormultiplier="160,210,255,255" />

        <!-- 【修复】各项 false / force=0 / 不带 Affliction = 只修船，不伤人、不炸物。
             写法照原版固化泡沫手榴弹的修复爆炸（mechanic_talent_items.xml:303）。 -->
        <Explosion range="250" structuredamage="-40" itemdamage="0" force="0.0"
                   smoke="false" flames="false" flash="false" sparks="false"
                   shockwave="false" underwaterbubble="false" camerashake="0" playtinnitus="false" />

        <!-- 一次性：用完自己消失（写法照原版 guardianrepairtool） -->
        <Remove />
      </StatusEffect>

    </Throwable>
  </Item>

  <!-- ============================================================
       命运之轮 mcj_wheeloffortune
       可投掷的范围减伤 + 治疗装置。由第三栏第 3 档天赋发放。

       【流程】掷出 → 落地碎裂 → 周围 400 内的船员获得 8 秒
              50% 全伤害抗性 + 持续治疗（详见 Afflictions）

       ── 落地碎裂怎么写 ──
       照原版手雷的通用写法：OnImpact 把自己打碎，OnBroken 再做事：
           <StatusEffect type="OnImpact" target="This" Condition="0.0" setvalue="true" />
       （写法来自原版液态氧石 alienitems.xml:335）

       ── 怎么把 buff 给到附近的人 ──
       原版实测写法（工程师的辐射发射器 engineer_talent_items.xml:754）：
           <StatusEffect type="Always" target="NearbyCharacters" range="125" interval="1">
             <Affliction identifier="radiationsickness" strength="1" />
           </StatusEffect>
       所以我们用 OnBroken + NearbyCharacters + <Affliction> 即可。

       ── 为什么限定 targets="human" ──
       NearbyCharacters 没有任何“队伍”过滤属性（字段全集里只有 target / targets /
       targetidentifiers / targettags 等，没有 team）。原版的做法就是用 targets 按
       物种过滤（Watcher.xml: "targets=\"human\""）。
           → 不限定的话，范围内的海怪也会被减伤 + 治疗，那就成了负面效果。
       ⚠️ 残留问题：敌方人类（海盗 / 分离主义者）仍会吃到 buff。
          原版也没有解决这个的写法，影响很小，先接受。

       【数值对照】
         原版 resistancefor="damage" 上限 0.5（Afflictions.xml:2612），基因材料 0.6
         本模组「天星交错」 0.15 / 「世界树之干」 0.2（都是永久生效）
         命运之轮 0.5，但只 8 秒、且靠消耗品触发 ============================================================ -->
  <Item name="" identifier="mcj_wheeloffortune" category="Equipment"
        tags="smallitem,wheeloffortune"
        cargocontaineridentifier="metalcrate" allowasextracargo="true" scale="0.5"
        impactsoundtag="impact_metal_light">

    <Price baseprice="200" sold="false" />

    <Deconstruct time="15">
      <Item identifier="fulgurium" />
      <Item identifier="plastic" />
    </Deconstruct>

    <Fabricate suitablefabricators="fabricator" requiredtime="30" requiresrecipe="true">
      <RequiredSkill identifier="medical" level="30" />
      <RequiredItem identifier="fulgurium" />
      <RequiredItem identifier="plastic" amount="2" />
    </Fabricate>

    <InventoryIcon texture="Content/Items/Alien/AlienMaterials.png" sourcerect="97,349,58,71" origin="0.5,0.5" />
    <Sprite texture="Content/Items/Alien/AlienMaterials.png" sourcerect="97,349,58,71" depth="0.55" origin="0.5,0.5" />
    <Body width="40" height="40" density="30" friction="1.0" angulardamping="20.0" />

    <Throwable characterusable="false" slots="Any,RightHand,LeftHand" throwforce="3.5"
               aimpos="35,-10" msg="ItemMsgPickUpSelect">

      <!-- 落地即碎 -->
      <StatusEffect type="OnImpact" target="This" Condition="0.0" setvalue="true" />

      <!-- 给周围船员上 buff（只限人类，不把怪物一并治好） -->
      <StatusEffect type="OnBroken" target="NearbyCharacters" range="400" targets="human" disabledeltatime="true">
        <Affliction identifier="mcj_wheeloffortune" strength="1" />
      </StatusEffect>

      <!-- 碎裂特效 -->
      <StatusEffect type="OnBroken" target="This">
        <Sound file="Content/Items/Alien/AlienTurret2.ogg" range="1500" />
        <ParticleEmitter particle="FlareBubbles" anglemin="0" anglemax="360"
                         velocitymin="0" velocitymax="150" particleamount="30"
                         scalemin="2.0" scalemax="3.0" />
        <ParticleEmitter particle="GlowDot" anglemin="0" anglemax="360"
                         velocitymin="0" velocitymax="0" particleamount="28"
                         scalemin="6.0" scalemax="6.0" colormultiplier="255,230,160,255" />
      </StatusEffect>

      <!-- 碎后不留残骸 -->
      <StatusEffect type="OnBroken" target="This">
        <Remove />
      </StatusEffect>

    </Throwable>
  </Item>

</Items>
