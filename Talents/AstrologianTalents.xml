    </AbilityGroupEffect>

    <!-- ② 自身伤害：基础 +10%（照原版 TalentsCaptain.xml:313 的 OnAttack + ModifyAttackData 结构） -->
    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.10" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionCharacter>
          <Conditional medical="gte 40" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.05" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionCharacter>
          <Conditional medical="gte 60" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.05" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionCharacter>
          <Conditional medical="gte 80" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.05" />
      </Abilities>
