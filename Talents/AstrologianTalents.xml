    <AbilityGroupInterval interval="5.0">
      <Conditions>
        <AbilityConditionHasTalent identifier="mcj_arrow" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_arrow_boost" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupInterval interval="5.0">
      <Conditions>
        <AbilityConditionHasTalent identifier="mcj_bole" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_bole_boost" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupInterval interval="5.0">
      <Conditions>
        <AbilityConditionHasTalent identifier="mcj_spire" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_spire_boost" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupInterval interval="5.0">
      <Conditions>
        <AbilityConditionHasTalent identifier="mcj_ewer" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_ewer_boost" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- ============================================================
       第三栏 · 天球仪（mcj_path_astrolabe）第 1 档

       直接发放一件天球仪，不给任何团队 buff。
       占用双手，所以是"常驻武器"同时也是它的限制：
       拿着它就干不了别的，想用就得从物品栏里取出来。
       ============================================================ -->
  <Talent identifier="mcj_astrolabe">
    <Icon texture="%ModDir%/Textures/Talents/Astrolabe.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_astrolabe" />

    <!-- 不能只用 abilityeffecttype="None"：那个时机可能在选天赋的界面里、
         角色还没出生，PutItem 无处可放就静默丢掉了。
         改成每秒重试的 interval + permanent stat 去重（结构与星天开门一致）。
         permanent stat 默认 removeondeath，所以死亡重生后会重新发放。 -->
    <AbilityGroupInterval interval="2.0">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_astrolabe_given" min="1" invert="true" />
      </Conditions>
      <Abilities>
        <CharacterAbilityPutItem itemidentifier="mcj_astrolabe" amount="1" />
        <CharacterAbilityGivePermanentStat statidentifier="mcj_astrolabe_given" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- ============================================================
       第三栏 · 地星（mcj_path_astrolabe）第 2 档

       地星是一件「预先布置」的一次性装置：
       放下 → 10 秒蓄力 → 舱室进水 → 修补船体 → 自己消失。
       详细机制与全部查证依据写在 Items/AstrologianItems.xml 里。

       【补给】地星是一次性的，所以这一档同时解锁它的配方
       （AddedRecipe + 物品里的 requiresrecipe="true"）。
       写法照原版机械师天赋 hullfixer，它就是这样解锁固化泡沫手榴弹的。

       【发放】结构与第 1 档天球仪完全一致：interval + permanent stat 去重。
       permanent stat 默认 removeondeath，所以死亡重生后会重新发放。
       ============================================================ -->
  <Talent identifier="mcj_earthlystar">
    <Icon texture="%ModDir%/Textures/Talents/EarthlyStar.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_earthlystar" />

    <AbilityGroupInterval interval="2.0">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_earthlystar_given" min="1" invert="true" />
      </Conditions>
      <Abilities>
        <CharacterAbilityPutItem itemidentifier="mcj_earthlystar" amount="1" />
        <CharacterAbilityGivePermanentStat statidentifier="mcj_earthlystar_given" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupInterval>

    <!-- 解锁配方：写法照原版机械师天赋 hullfixer -->
    <AddedRecipe itemidentifier="mcj_earthlystar" />
  </Talent>

  <!-- ============================================================
       第三栏 · 命运之轮（mcj_path_astrolabe）第 3 档

       可投掷的范围减伤 + 治疗装置：掷出 → 落地碎裂 →
       周围 400 内的人类船员获得 8 秒 50% 全伤害抗性 + 持续治疗。
       机制与全部查证依据写在 Items/AstrologianItems.xml 里。

       和地星一样：发放一颗 + 解锁配方（AddedRecipe + requiresrecipe）。
       ============================================================ -->
  <Talent identifier="mcj_wheeloffortune">
    <Icon texture="%ModDir%/Textures/Talents/WheelOfFortune.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_wheeloffortune" />

    <AbilityGroupInterval interval="2.0">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_wheeloffortune_given" min="1" invert="true" />
      </Conditions>
      <Abilities>
        <CharacterAbilityPutItem itemidentifier="mcj_wheeloffortune" amount="1" />
        <CharacterAbilityGivePermanentStat statidentifier="mcj_wheeloffortune_given" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupInterval>

    <AddedRecipe itemidentifier="mcj_wheeloffortune" />
  </Talent>

  <!-- ============================================================
       第三栏 · 占卜（mcj_path_astrolabe）第 4 档

       占星术士把星象读透：知道该打哪里、该怎么打。

       ① 医疗技能 +45   （对标 TE 闪电巫师 lightningwizard：ElectricalSkillBonus 45）
       ② 自身伤害加成，随医疗技能阶梯提升（最高 +30%）
       ③ 附近队友（1000 内）获得 +10% 伤害

       ── ② 的阶梯是怎么实现的 ──
       写了 5 个 OnAttack 组，基础一个无条件 +10%，
       另 4 个各带一道递增的医疗门槛（40 / 60 / 80 / 100），每个 +5%。
       同一组内的多个条件是与关系，不同组的加成会累加，
       所以医疗技能越高，命中的组越多：
           医疗 < 40  → 10%
           ≥ 40      → 15%
           ≥ 60      → 20%
           ≥ 80      → 25%
           ≥ 100     → 30%
       技能条件写法照原版 mechanic_talent_items.xml（mechanical="lt 40"）。
       数值上限 +30% 对标 TE「暴力军阀 warlord」的 AttackMultiplier 0.1→0.5。

       ⚠️ 若发现阶梯没生效（永远只 +10% 或直接 +30%），
          就把门槛改成固定一档，或者改用 4 个独立天赋分开给。
       ============================================================ -->
  <Talent identifier="mcj_divination">
    <Icon texture="%ModDir%/Textures/Talents/Divination.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_divination" />

    <!-- ① 医疗技能 +45 -->
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveStat stattype="MedicalSkillBonus" value="45" />
      </Abilities>
    </AbilityGroupEffect>

    <!-- ② 自身伤害：基础 +10%（照原版 TalentsCaptain.xml:313 的 OnAttack + ModifyAttackData 结构） -->
    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.10" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionCharacter>
          <Conditional medical="gte 40" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.05" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionCharacter>
          <Conditional medical="gte 60" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.05" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionCharacter>
          <Conditional medical="gte 80" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.05" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionCharacter>
          <Conditional medical="gte 100" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.05" />
      </Abilities>
    </AbilityGroupEffect>

    <!-- ③ 附近队友的小幅增伤（allowself=false：自己拿上面那份大的） -->
    <AbilityGroupInterval interval="3.0">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="1000" allowself="false">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_divination" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- ============================================================
       初级树（mcj_astrologian_primary）

       初级树是「通用医疗兵基本功」。其中 6 个沿用原版医生的天赋
       （exampleofhealth / laresistance / selfcare / stayinalive /
         firemanscarry / dontdieonme）—— 这些本来就是通用能力，不改。

       下面 5 个是自写的，专门替换原版医生那五个「字面写着医生」的天赋：
           healthinsurance  医疗保险       -> 星图
           nobodyimportantdies 专门强化助手 -> 命理交织
           medicalcompanion 医疗伴侣       -> 守护星
           nopressure       无压           -> 星轨测深
           blooddonor       献血者         -> 凶星

       ⚠️ 必须用新 ID。直接改写原版 ID 会连带改掉原版医生，
          而且会和「天赋增强」(TE) 打架 —— TE 正在覆盖同一批原版天赋。

       名字说明：「星图」「守护星」「星轨测深」是占星术语，不是 FF14 技能名。
          只给效果与原作一致的两个用了官方名：凶星 = Malefic（伤害）、
          命理交织 = Synastry（治疗目标时自己也回一点）。
       ============================================================ -->

  <!-- 星图 ← 原版 healthinsurance（机制原样，只换名字与永久标记 ID） -->
  <Talent identifier="mcj_primary_starchart">
    <Icon texture="%ModDir%/Textures/Talents/StarChart.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.healthinsurance">
      <Replace tag="[amount]" value="30" color="gui.orange" />
      <Replace tag="[money]" value="100" color="gui.green" />
    </Description>
    <Description tag="talentdescription.medicalitemscostless">
      <Replace tag="[amount]" value="10" color="gui.green" />
    </Description>

    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="mcj_starchart" stattype="StoreBuyMultiplier" value="0.1" setvalue="true" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupInterval interval="1">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_starchart" min="1" invert="true" />
        <AbilityConditionAboveVitality invert="true" vitalitypercentage="0.3" />
      </Conditions>
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="mcj_starchart" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupEffect abilityeffecttype="OnAnyMissionCompleted">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_starchart" min="1" />
      </Conditions>
      <Abilities>
        <CharacterAbilityGiveMoney amount="100" />
        <CharacterAbilityResetPermanentStat statidentifier="mcj_starchart" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <!-- 命理交织 ← 原版 nobodyimportantdies（新效果）
       原作 Synastry 的效果就是「治疗目标时自己也回一点」，直接对应。 -->
  <Talent identifier="mcj_primary_synastry">
    <Icon texture="%ModDir%/Textures/Talents/Synastry.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_synastry" />

    <AbilityGroupEffect abilityeffecttype="OnApplyTreatment">
      <Conditions>
        <AbilityConditionCharacter targettype="Ally,NotSelf" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" disabledeltatime="true">
              <Affliction identifier="mcj_synastry" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <!-- 守护星 ← 原版 medicalcompanion -->
  <Talent identifier="mcj_primary_guardianstar">
    <Icon texture="%ModDir%/Textures/Talents/GuardianStar.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.unlockrecipe">
      <Replace tag="[itemname]" value="entityname.autoinjectorheadset" color="gui.orange" />
    </Description>
    <AddedRecipe itemidentifier="autoinjectorheadset" />
  </Talent>

  <!-- 星轨测深 ← 原版 nopressure -->
  <Talent identifier="mcj_primary_starsounding">
    <Icon texture="%ModDir%/Textures/Talents/StarSounding.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.unlockrecipe">
      <Replace tag="[itemname]" value="entityname.pressurestabilizer" color="gui.orange" />
    </Description>
    <AddedRecipe itemidentifier="pressurestabilizer" />
  </Talent>

  <!-- 凶星 ← 原版 blooddonor（新效果）
       Malefic 是占星术士的核心伤害法术，效果也就对应增伤。
       基础树里的小幅增伤，对标 TE「暴力军阀 warlord」的起点 0.1。 -->
  <Talent identifier="mcj_primary_malefic">
    <Icon texture="%ModDir%/Textures/Talents/Malefic.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_malefic" />

    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.1" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

</Talents>
