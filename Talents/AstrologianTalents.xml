      </Abilities>
    </AbilityGroupInterval>

    <!-- ④ 击杀累积（2026-09-15 新增）：每击杀一名敌人 +1 层，每层 +1% 伤害，封顶 +20%。

         这是纯 XML 的「层数系统」，写法照巫女模组（工坊 3668933349）的「灵力」计数器：
            · 计数器  = 一条【不带 stattype】的 permanent stat，每事件 value="1"
            · 派生效果 = 同一个 statidentifier 再写一条【带 stattype】的 GivePermanentStat，
                        其中 value = 每层给多少、maxvalue = 封顶
                        → 引擎自己算「层数 × value」，不用手写 20 组阶梯
                        （巫女验算：20 层 × 0.005 = 0.1 = maxvalue）

         封顶用了两道保险：
           ① AbilityConditionHasPermanentStat ... invert="true" → 满 20 层后不再计数
           ② maxvalue="0.2"                                     → 即使计数溢出也不会超

         其他要点：
            · OnKillCharacter + AbilityConditionCharacter targettypes="Enemy"
              = 只算敌对目标（照原版安全官 warstories，TalentsSecurity.xml:210）
            · removeondeath="false" = 死亡不清零（否则一死就白攒）
            · 这条是【永久】累积、不随巡回重置（与巫女灵力一致）；
              若想改成「每巡回清零」，加一组：
              <AbilityGroupEffect abilityeffecttype="OnRoundEnd">
                <Abilities><CharacterAbilityResetPermanentStat statidentifier="mcj_divination_kills" /></Abilities>
              </AbilityGroupEffect> -->
    <AbilityGroupEffect abilityeffecttype="OnKillCharacter">
      <Conditions>
        <AbilityConditionCharacter targettypes="Enemy" />
        <AbilityConditionHasPermanentStat statidentifier="mcj_divination_kills" min="20" invert="true" />
      </Conditions>
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="mcj_divination_kills" value="1" removeondeath="false" />
      </Abilities>
    </AbilityGroupEffect>

    <!-- 计数器派生出伤害：20 层 × 0.01 = +20%
         （放在 abilityeffecttype="None" 组里 = 点出天赋时就注册一次，
           之后层数变化，引擎会自动重算这条永久 stat） -->
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="mcj_divination_kills"
                                           stattype="AttackMultiplier" value="0.01" maxvalue="0.2" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <!-- ============================================================
       初级树（mcj_astrologian_primary）

       2026-09-15 定稿的构成（共 10 个）：

       ① 自写的 5 个（替换原版医生那五个「字面写着医生」的天赋）
            healthinsurance      医疗保险     -> mcj_primary_starchart      星图
            nobodyimportantdies  专门强化助手 -> mcj_primary_synastry      星位合图
            medicalcompanion     医疗伴侣     -> mcj_primary_guardianstar  擢升
            nopressure           无压         -> mcj_primary_starsounding  重力
            blooddonor           献血者       -> mcj_primary_malefic       凶星
       ② 由原版天赋改写而来的 3 个（效果原样，只换名字与图标，见本文件末尾）
            exampleofhealth      健康典范     -> mcj_primary_wheeloffortune        命运之轮
            laresistance         抵抗军       -> mcj_primary_celestialopposition   天星交错
            dontdieonme          冥土追魂     -> mcj_primary_ascend                生辰
       ③ 直接沿用原版的 2 个：stayinalive 求生意志 / firemanscarry 消防搬运

       【已删】原版 selfcare（自我保健）—— 按要求移除，不再出现在初级树里。

       ⚠️ 必须用新 ID。直接改写原版 ID 会连带改掉原版医生，
          而且会和「天赋增强」(TE) 打架 —— TE 正在覆盖同一批原版天赋。

       ⚠️ 名字与效果的过渡状态：命运之轮 / 天星交错 / 生辰 现在挂的
          是原版通用医疗兵效果，与 FF14 原作效果不一致
         （原作分别是减伤领域 / 护盾 / 复活），属于「先占名字、效果之后再换」。
       ============================================================ -->

  <!-- 星图 ← 原版 healthinsurance（机制原样，只换名字与永久标记 ID）
       2026-09-15 追加第三条效果：队友击杀敌人时，自己也获得一点升级经验。 -->
  <Talent identifier="mcj_primary_starchart">
    <Icon texture="%ModDir%/Textures/Talents/StarChart.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.healthinsurance">
      <Replace tag="[amount]" value="30" color="gui.orange" />
      <Replace tag="[money]" value="100" color="gui.green" />
    </Description>
    <Description tag="talentdescription.medicalitemscostless">
      <Replace tag="[amount]" value="10" color="gui.green" />
    </Description>
    <Description tag="talentdescription.mcj_starchart_killxp">
      <Replace tag="[amount]" value="5" color="gui.green" />
    </Description>

    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="mcj_starchart" stattype="StoreBuyMultiplier" value="0.1" setvalue="true" />
      </Abilities>
    </AbilityGroupEffect>

    <AbilityGroupInterval interval="1">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_starchart" min="1" invert="true" />
        <AbilityConditionAboveVitality invert="true" vitalitypercentage="0.3" />
      </Conditions>
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="mcj_starchart" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupEffect abilityeffecttype="OnAnyMissionCompleted">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_starchart" min="1" />
      </Conditions>
      <Abilities>
        <CharacterAbilityGiveMoney amount="100" />
        <CharacterAbilityResetPermanentStat statidentifier="mcj_starchart" />
      </Abilities>
    </AbilityGroupEffect>

    <!-- ⭐ 队友击杀敌人 → 自己也获得一点升级经验（2026-09-15）

         写法照工坊 Toxicologist（2993275947）的「猎头者」bountyhunter：
         OnCrewKillCharacter = 「任意船员击杀时」，不是只有自己。
         abilityeffecttype 里没有「队友获得经验」这种触发时机，
         所以用「队友击杀」这个动作当代理。

         为什么不能写成「队友获得的 25%」：
           · 天赋能给经验的唯一能力是 CharacterAbilityGiveExperience，
             参数只有 amount（固定值）/ level（补到某等级）—— 没有按比例分配
           · 唯一的比例机制 StealPercentageOfExperience 只挂在 <TraitorEvent> 上
             （TraitorEvents.xml 33 处，内鬼事件专用属性），天赋用不到
         → 所以只能给固定值：每次 5 点。

         ⚠️ OnCrewKillCharacter 不区分是谁杀的，包括自己杀的。
            如果实测发现「自己击杀也加」，想改成只算别人杀的，
            再想办法（目前原版没有现成的“排除自己”条件）。 -->
    <AbilityGroupEffect abilityeffecttype="OnCrewKillCharacter">
      <Conditions>
        <AbilityConditionCharacter targettypes="Enemy" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This">
              <GiveExperience amount="5" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

