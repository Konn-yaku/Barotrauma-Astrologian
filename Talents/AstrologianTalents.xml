<?xml version="1.0" encoding="utf-8"?>
<!--
  占星术士 · 治疗线天赋
  
  【重要背景】潜渊症没有"回血"概念。角色身上挂着各种状态（affliction），
  医生的工作是【削减它们】。所以这里的每个天赋都不是"加治疗量"，
  而是"让药更有效 / 减少用药 / 自动处理状态"。
  
  设计基线：原版医生「医生」专精线（4 层，第 2/3 层二选一）。
  所有天赋目前都对应到 mcj_path_healing 这一条子树。
-->
<Talents>

  <!-- ============================================================
       第 1 层 · 【占位符】

       2026-09-15：本档改为「天星交错 —— 对盟友施药后，该盟友获得生命上限加成」。
       实现完全照抄原版医生「维生素补充剂」vitaminsupplements
       （Content/Talents/Doctor/TalentsDoctor.xml:406）：
         · abilityeffecttype="OnApplyTreatment" —— 只在【对盟友施药/治疗】时触发
         · AbilityConditionCharacter targettype="Ally,NotSelf" —— 目标必须是盟友、且不是自己
         · CharacterAbilityGiveAffliction strength="600" setvalue="true"
           —— 给该盟友挂上 mcj_opposition（生命上限 +20%），持续到巡回结束。
       原版给的 strength 是 600，而 affliction 的 maxstrength="60" 会把它封顶，
       所以实际效果就是「把强度拉满」。
       ⚠️ CharacterAbilityGiveAffliction 的目标是【事件目标】（不是自己）——
          这里的事件目标就是被施药的盟友，正合需求。
       ⚠️ 本模组初级树里的「命运之轮」（mcj_primary_wheeloffortune）已经是
          「最大生命 +20%」（原版健康典范换皮），两者会重叠，之后若要区分再调。
       ============================================================ -->
  <Talent identifier="mcj_celestialopposition">
    <Icon texture="%ModDir%/Textures/Talents/CelestialOpposition.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_opposition" />

    <AbilityGroupEffect abilityeffecttype="OnApplyTreatment">
      <Conditions>
        <AbilityConditionCharacter targettype="Ally,NotSelf" />
      </Conditions>
      <Abilities>
        <CharacterAbilityGiveAffliction affliction="mcj_opposition" strength="600" setvalue="true" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <!-- ============================================================
       第 2 层 · 先天禀赋（二选一）
       
       【保守版】目标生命值低于 30% 时，你的治疗效果 ×2.2（+120%）；
       其余情况无加成。
       
       为什么只做两档：这里用的是原版 nobodyimportantdies / healthinsurance
       验证过的"条件 + FallbackAbilities"结构，最稳。
       想要 5 档阶梯的话，需要先在游戏里实测"多个同类型
       AbilityGroupEffect 是否会叠加"，确认后再扩展。
       ============================================================ -->
  <Talent identifier="mcj_essentialdignity">
    <Icon texture="%ModDir%/Textures/Talents/EssentialDignity.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_essentialdignity" />

    <!-- 【修复】这里原本还有一个 FallbackAbilities（multiplyvalue="1.0"）
         用来表示"不满足条件时不给加成"。但游戏会报错：
           "added value is 0 and multiplier is 1, the ability will do nothing"
         因为 multiplier=1 且 addedvalue=0（默认）确实是空操作。
         直接删掉即可——不满足条件时什么也不发生，正是我们想要的行为。 -->
    <AbilityGroupEffect abilityeffecttype="OnReduceAffliction">
      <Conditions>
        <AbilityConditionCharacter targetabilitytarget="true">
          <Conditional healthpercentage="lt 30" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyValue multiplyvalue="2.2" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <!-- ============================================================
       第 2 层 · 光速（二选一）

       = 原版「应急反应的换皮」+ 一条常驻的拖拽强化。
       ① 拖拽角色不减速 —— MoveNormallyWhileDragging flag，常驻。
          全游戏没有"拖拽速度"类 stattype（只有这一个二进制 flag），所以它没有
          可调的档位，只有"减不减速"两种状态。原版两个用例：
          firemanscarry（医生初级树直接给）与「应急反应」给助手的那条 affliction。
          ※ 我们初级树里本来就有 firemanscarry —— 对同时点了它的人这条是重复的，
            不会叠加出额外收益，但光速自己就送，不依赖初级树。
       ② 有人昏迷时 +40% 移速 —— 原版应急反应（emergencyresponse）的数值。

       ※ 这里刻意【不给】心肺复苏加成：原版「冥土追魂」(dontdieonme, CPRBoost 1)
         已经在我们的初级树第 2 组里（5 选 5，人人可点）。两边都给的话，
         万一 CPRBoost 是累加的，双修就是 3 倍心肺复苏 —— 没必要重复。
       ============================================================ -->
  <Talent identifier="mcj_lightspeed">
    <Icon texture="%ModDir%/Textures/Talents/Lightspeed.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_lightspeed" />

    <!-- 常驻：拖拽角色不减速 -->
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveFlag flagtype="MoveNormallyWhileDragging" />
      </Abilities>
    </AbilityGroupEffect>

    <!-- 有人昏迷时：+40% 移动速度 -->
    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionCrewMemberUnconscious />
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyStat stattype="MovementSpeed" value="0.4" />
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- ============================================================
       第 3 层 · 阳星合相（mcj_aspectedhelios）

       2026-09 改版（第三次）：定为「濒死急救」。
       600 范围内、生命值低于 20% 的队友会被自动清除流血 / 烧伤 / 失血；
       高于 20% 时完全不生效，伤口原样保留、照常扣血。
       定位：防止有人流血流死而来不及抢救，不是常驻治疗光环。

       范围 600 = 原版医生「奇迹工作者」miracleworker 的 maxdistance
       （原版免死光环的写法：CharacterAbilityApplyStatusEffectsToAllies maxdistance="600"）。
       限制：只有施术者本人在潜艇内时才生效。
       mcj_helios 带 duration="2"，每秒刷新 → 离开范围约 2 秒后自动失效。
       ============================================================ -->
  <Talent identifier="mcj_aspectedhelios">
    <Icon texture="%ModDir%/Textures/Talents/AspectedHelios.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_aspectedhelios" />

    <AbilityGroupInterval interval="1.0">
      <Conditions>
        <AbilityConditionInHull />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="600" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_helios" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- ============================================================
       第 4 层 · 星天开门（大招）
       
       进入任务时，给全船每人发一张护身符（无距离限制，原版 stayinalive
       就是不写 maxdistance 的全图生效写法）。
       
       护身符的"消耗"逻辑写在 Afflictions 里的 mcj_stargate 自身，
       所以每个人各自独立触发、只消耗自己的那一张。

       2026-09-15 改版：效果换成【安全官最终技「不屈」implacable 同款的短时间免死】。
       谁的活力跌破 1%，谁的符就烧掉，换来 15 秒的「不屈」（不会昏迷 + 伤害 +25%）。
       阈值与原版 implacable 完全一致（都是 1% 活力）。
       
       「每任务一次」用 permanent stat 标记 + 任务结束重置实现，
       结构照抄原版 healthinsurance。
       ============================================================ -->
  <Talent identifier="mcj_stargate">
    <Icon texture="%ModDir%/Textures/Talents/Stargate.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_stargate" />

    <!-- 进入任务时发放护身符：本任务还没发过就发 -->
    <!-- 进入任务时发放护身符：本任务还没发过就发。
         maxdistance 显式写一个大数值 —— 虽然原版 stayinalive 不写也能全图生效，
         但为了排除"不写 = 距离 0 = 谁都拿不到"这种可能性，这里写死。 -->
    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_stargate_given" min="1" invert="true" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_stargate" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
        <CharacterAbilityGivePermanentStat statidentifier="mcj_stargate_given" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupInterval>

    <!-- 【修改】重置标记：改用 OnRoundEnd 而不是 OnAnyMissionCompleted。
         原因：OnAnyMissionCompleted 需要"任务被完成"才触发。
         如果你死了、或者中途退出，标记就永远不会被清除，
         导致之后的每一个任务都不再发放护身符。
         OnRoundEnd 只要这一局结束就会触发，更可靠。 -->
    <AbilityGroupEffect abilityeffecttype="OnRoundEnd">
      <Abilities>
        <CharacterAbilityResetPermanentStat statidentifier="mcj_stargate_given" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <!-- ============================================================
       第二栏 · 奥秘卡（mcj_path_arcanum）
       ============================================================

       【6 张卡的统一结构】
         AbilityGroupInterval 每 5 秒重跑一次，
         把自己的卡施给全图的友方（maxdistance 写到 200000 = 无距离限制，
         和本文件里「星天开门」用的是同一个写法）。
         buff 本身没有 duration，配合 resetbetweenrounds="true"
         → 整局常驻、任务结束自动清除。

       【为什么是"卡给全队"而不是"给随机一个人"】
         这是第二栏的设计前提：卡是常驻的团队增益，
         不做抽卡、不做随机目标，避免"需要战斗时抽到潜水卡"。

       【数值定稿】见 Afflictions/AstrologianAfflictions.xml 的注释。
       ============================================================ -->

  <!-- ============================================================
       第 1 档 · 六天座 —— 抽卡循环的开关

       点出后发一本「星极抽卡」，之后全靠书自己接力：
         星极 →（60 秒）→ 灵极 →（60 秒）→ 星极 …
       天赋本身【只发这一本】。

       ⚠️⚠️⚠️ 血的教训：不要用 HasItem + FallbackAbilities 做"没书就自动补一本" ⚠️⚠️⚠️

       官方文档（<游戏目录>/BuildDocClient.xml，搜索 fallbackAbilities）原文：
         "Fallback abilities are triggered if the conditional fails"
       ⇒ 条件不成立时，fallback 会【按 interval 的节奏反复执行】。

       所以 `interval="2.0"` + 条件 `AbilityConditionHasItem tags="mcjarcanumdraw"`
       + fallback `PutItem` 这套写法，只要那个条件有任何一次判不出来
       （书放在通用背包格而不是手持/穿戴格、中继那一步没生成出新书、
        背包满导致 PutItem 放不下……），
       就会立刻变成「每 2 秒塞一本书」的无限刷书 —— 2026-09-15 实测踩到。

       而且 HasItem 这条路走不通的地方在于：
         · 原版 3 处 HasItem 全部用在【穿戴品】上（潜水服 / 防化服 / 小丑装），
           它的判定范围没有原版实据；
         · 想反过来写"没有书"也不行 —— HasItem 不支持 invert（原版零实例），
           HasAffliction 也不支持 invert（原版 + 工坊全域零实例）；
         · AbilityConditionItemInSubmarine 只有 submarinetype / invert 两个属性，
           没法按 tag 筛；AbilityConditionCharacter 不带 targettype 时指的是
           【事件目标】而不是自己（原版 TalentsMechanic.xml:84 可证），
           放进 interval 组里没有意义。

       【现在的写法】永久属性当锁，只发一次。与天球仪（mcj_astrolabe）、
       地星（mcj_earthlystar）用的是同一个已验证模式。
       permanent stat 的 removeondeath 默认为 true，所以角色重生后锁自动清掉。
       ============================================================ -->
  <Talent identifier="mcj_arcanum_six">
    <Icon texture="%ModDir%/Textures/Talents/SixCards.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_arcanum_six" />
    <AbilityGroupInterval interval="2.0">
      <Conditions>
        <AbilityConditionHasPermanentStat statidentifier="mcj_six_given" min="1" invert="true" />
      </Conditions>
      <Abilities>
        <CharacterAbilityPutItem itemidentifier="mcj_draw_star" amount="1" />
        <CharacterAbilityGivePermanentStat statidentifier="mcj_six_given" value="1" setvalue="true" removeondeath="false" />
      </Abilities>
    </AbilityGroupInterval>

    <!-- ===== v0.12.6：本天赋不再维护任何标记 =====
         mcj_roundflag 改由【抽卡书自己】每 5 秒补（见物品文件）。
         为什么不在这里补：六天座在巡回一开始就会把标记补上 →
         「标记缺失」这个窗口会缩短到看不见 → 牌的轮次重置就永远不会触发。
         下面两段是 v0.12.5 的说明，已作废。
         （另一个标记 mcj_minor_flag 已在 v0.12.6 废弃：它想表达「没解锁」，
           但 <Conditional mcj_minor_flag="lte 0.1" /> 写在 target="This,Character"
           的特效里时，条件会拿【物品】去解析 → 角色身上的标记永远找不到 →
           强度按 0 算 → lte 0.1 恒成立 → 没点天赋也发卡。
           现在改成「已解锁」标记 mcj_arcanum_unlocked，由第 3 档天赋每 0.5 秒
           挂给自己，判定挪到【王冠卡自己】身上，见物品文件。）
         标记 B mcj_roundflag：「本轮有效」。每 10 秒补一次、本身没有 duration，
           所以整轮都在；只有 resetbetweenrounds="true" 会让它在巡回结束时消失。
           于是「它不见了」= 新的一轮刚开始 → 灵极书自行变回星极书（见物品文件）。
         两个都必须用 ApplyStatusEffects + target="Character"（给自己），
         因为 CharacterAbilityGiveAffliction 的目标是【事件目标】不是自己。 -->
    <!-- ============================================================
         卡牌广播组：把 6 张卡的增益扩散给全队
         ============================================================
         链路：卡打出（物品）→ 只给使用者上一个 2 秒的「信号弹」affliction
               → 这里每 0.5 秒轮询一次，看到信号就广播真 buff，然后把信号清掉。

         【为什么必须挂在天赋里，不能靠卡自己】
           物品拿不到 CharacterAbilityApplyStatusEffectsToAllies。
           而卡自己写 target="NearbyCharacters" 既没有队伍过滤（会顺手给敌人上 buff）、
           又有距离限制，做不到"全队、无视距离"。

         【为什么用信号弹，而不是直接检测 buff 本身】
           如果直接检测 mcj_balance，buff 还在的 15 秒里会被每 0.5 秒重新广播一次，
           等于把 15 秒续成永久。信号弹是"即用即清"的，天生不会反复触发。

         【maxdistance="200000" + allowself="true"】
           与第 4 档「星力」完全同一写法（星力已实测：全船都能吃到增益）。
           allowself 让施术者自己也吃到 → "只给自己"和"给全队"是同一份数值，
           不会出现两套数字互相漂移。
         ============================================================ -->
    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="mcj_sig_balance" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_balance" amount="1" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
        <CharacterAbilityReduceAffliction afflictionId="mcj_sig_balance" amount="999" />
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="mcj_sig_spear" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_spear" amount="1" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
        <CharacterAbilityReduceAffliction afflictionId="mcj_sig_spear" amount="999" />
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="mcj_sig_arrow" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_arrow" amount="1" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
        <CharacterAbilityReduceAffliction afflictionId="mcj_sig_arrow" amount="999" />
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="mcj_sig_bole" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_bole" amount="1" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
        <CharacterAbilityReduceAffliction afflictionId="mcj_sig_bole" amount="999" />
      </Abilities>
    </AbilityGroupInterval>

    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="mcj_sig_spire" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_spire" amount="1" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
        <CharacterAbilityReduceAffliction afflictionId="mcj_sig_spire" amount="999" />
      </Abilities>
