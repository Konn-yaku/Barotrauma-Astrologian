    <!-- 解锁配方：书丢了可以自己花 1 个塑料重做一本，把循环拉回来。
         这是"没有某物品"表达不出来的替代方案（见上方长注释）。
         写法照原版机械师天赋 hullfixer，物品那边配 requiresrecipe="true"。 -->
    <AddedRecipe itemidentifier="mcj_draw_star" />
  </Talent>

  <!-- ============================================================
       第 2 档 · 重抽 —— 拆解产出概率翻倍
       照原版机修工「残留废料」residualwaste：
         OnItemDeconstructedMaterial + ServerRandom 20% + ModifyValue ×2
       排除清单也照抄（防刷：基因材料、FPGA 电路、灯管组件）
       ============================================================ -->
  <Talent identifier="mcj_arcanum_redraw">
    <Icon texture="%ModDir%/Textures/Talents/Redraw.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_arcanum_redraw" />
    <AbilityGroupEffect abilityeffecttype="OnItemDeconstructedMaterial">
      <Conditions>
        <AbilityConditionServerRandom randomChance="0.2" />
        <AbilityConditionItem tags="geneticmaterial,unidentifiedgeneticmaterial,circuitboxcomponent,lightcomponent,disallowduplicatedeconstructoutput" invert="true" />
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyValue multiplyvalue="2" />
      </Abilities>
    </AbilityGroupEffect>
