  </Talent>

  <!-- ============================================================
       星力 —— 第二栏第 4 档（大招）
       把上面 6 张卡的效果整体放大。

       【实现方式】给每张卡各配一个 "_boost" affliction，
       当且仅当你点出了那张卡的天赋时才施加。
       两个 affliction 的 StatValue 自然相加 = 基础值 + 增量。

       【为什么每张卡要单独一块 AbilityGroupInterval】
       条件写在 AbilityGroup 层级，无法只作用于组里的某一条 ability，
       所以"逐卡判断是否已解锁"就必须拆成 6 块。

       【为什么不抬高同一个 affliction 的强度】
       GiveAffliction 是往 maxstrength 累加饱和的，
       基础值与强化值最终都会顶到上限，效果一样，区分不出来。
       ============================================================ -->
  <Talent identifier="mcj_astrodyne">
    <Icon texture="%ModDir%/Textures/Talents/Astrodyne.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_astrodyne" />

    <AbilityGroupInterval interval="5.0">
      <Conditions>
        <AbilityConditionHasTalent identifier="mcj_balance" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_balance_boost" amount="1.0" />
            </StatusEffect>
