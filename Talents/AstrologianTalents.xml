    <Description tag="talentdescription.mcj_balance" />
    <AbilityGroupInterval interval="5.0">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_balance" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- 战争神之枪：全队攻击速度 -->
  <Talent identifier="mcj_spear">
    <Icon texture="%ModDir%/Textures/Talents/Spear.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_spear" />
    <AbilityGroupInterval interval="5.0">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_spear" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- 放浪神之箭：全队移动速度与游泳速度 -->
  <Talent identifier="mcj_arrow">
    <Icon texture="%ModDir%/Textures/Talents/Arrow.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_arrow" />
    <AbilityGroupInterval interval="5.0">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_arrow" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- 世界树之干：全队伤害抗性 -->
  <Talent identifier="mcj_bole">
    <Icon texture="%ModDir%/Textures/Talents/Bole.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_bole" />
    <AbilityGroupInterval interval="5.0">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_bole" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- 建筑神之塔：全队修理速度与修船壳速度 -->
  <Talent identifier="mcj_spire">
    <Icon texture="%ModDir%/Textures/Talents/Spire.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_spire" />
    <AbilityGroupInterval interval="5.0">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_spire" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <!-- 河流神之瓶：全队氧气消耗 -->
  <Talent identifier="mcj_ewer">
    <Icon texture="%ModDir%/Textures/Talents/Ewer.png" sourcerect="0,0,128,128" origin="0,0" />
    <Description tag="talentdescription.mcj_ewer" />
    <AbilityGroupInterval interval="5.0">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies maxdistance="200000" allowself="true">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
              <Affliction identifier="mcj_ewer" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
