<?xml version="1.0" encoding="utf-8"?>
<!--
  占星术士 · 天赋树
  
  【当前状态】三条专精线：
    mcj_path_healing  —— 治疗线（第一栏，已实装）
    mcj_path_arcanum  —— 奥秘卡（第二栏，已实装）
    mcj_path_scientist—— 作战辅助（第三栏，仍是医生「化学家」镜像的占位）

  初级树 mcj_astrologian_primary 目前仍是医生初级树的镜像，待重做。

  ── 参数语义（来自官方 API 文档 BuildDocClient.xml）──
    TalentTree jobidentifier
        挂到哪个职业，必须和 Jobs 里的 identifier 一致
    SubTree type="primary" / "specialization"
        初级树开局可点；专精树需要 requires 指定的前置树
    SubTree blocks
        互斥：选了这条专精后，blocks 里列出的专精将无法再选
    TalentOptions requiredtalents
        官方定义："How many talents need to be unlocked to consider this tree completed"
        → 这一组需要点出几个天赋，才算完成本组（进而解锁下一组）
    TalentOptions maxchosentalents
        官方定义："How many talents can be unlocked in total"
        → 这一组最多能选几个
    ShowCaseTalent
        点击后展开的二选一入口（我们之后如果要"分支选择"就用它）
-->
<TalentTrees>

  <TalentTree jobidentifier="mcj_astrologian">

    <!-- ================= 初级：与医生初级树完全一致 ================= -->
    <SubTree identifier="mcj_astrologian_primary" nameidentifier="talenttree.primary" type="primary">

      <TalentOptions requiredtalents="1" maxchosentalents="6">
        <TalentOption identifier="healthinsurance" />
        <TalentOption identifier="nobodyimportantdies" />
        <TalentOption identifier="exampleofhealth" />
        <TalentOption identifier="laresistance" />
        <TalentOption identifier="selfcare" />
        <TalentOption identifier="stayinalive" />
      </TalentOptions>

      <TalentOptions requiredtalents="1" maxchosentalents="5">
        <TalentOption identifier="firemanscarry" />
        <TalentOption identifier="medicalcompanion" />
        <TalentOption identifier="dontdieonme" />
        <TalentOption identifier="nopressure" />
        <TalentOption identifier="blooddonor" />
      </TalentOptions>

    </SubTree>

    <!-- ================= 专精 A：奥秘卡（第二栏 · 团队辅助）=================
         6 张奥秘卡（FF14 占星术士的标志性机制）+ 第 4 档大招「星力」。
         被动、全队常驻，不做抽卡、不做随机目标。
         每档 = 1 张星极 + 1 张灵极，对应原作的两个抽卡按钮。

         数值全部取自原版对应天赋/基因的下方区间，星力后仍低于原版。
         天赋实现见 Talents/AstrologianTalents.xml
         状态实现见 Afflictions/AstrologianAfflictions.xml -->
    <SubTree identifier="mcj_path_arcanum" type="specialization"
             requires="mcj_astrologian_primary">

      <!-- 第 1 档 -->
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="mcj_balance" />
        <TalentOption identifier="mcj_spear" />
      </TalentOptions>

      <!-- 第 2 档 -->
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="mcj_arrow" />
        <TalentOption identifier="mcj_bole" />
      </TalentOptions>

      <!-- 第 3 档 -->
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="mcj_spire" />
        <TalentOption identifier="mcj_ewer" />
      </TalentOptions>

      <!-- 第 4 档 -->
      <TalentOptions>
        <TalentOption identifier="mcj_astrodyne" />
      </TalentOptions>

    </SubTree>

    <!-- ================= 专精 B：治疗线（我们自己的第一支）=================
         这是目前唯一已经完成设计的一条线。
         4 层结构，第 2 层二选一，其余无选择 —— 与原版医生的「医生」子树同构。
         天赋实现见 Talents/AstrologianTalents.xml
         状态实现见 Afflictions/AstrologianAfflictions.xml

         名字是占位的，等三条线定完再统一取。 -->
    <SubTree identifier="mcj_path_healing" type="specialization"
             requires="mcj_astrologian_primary">
      <TalentOptions>
        <TalentOption identifier="mcj_celestialopposition" />
      </TalentOptions>
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="mcj_essentialdignity" />
        <TalentOption identifier="mcj_lightspeed" />
      </TalentOptions>
      <TalentOptions>
        <TalentOption identifier="mcj_aspectedhelios" />
      </TalentOptions>
      <TalentOptions>
        <TalentOption identifier="mcj_stargate" />
      </TalentOptions>
    </SubTree>

    <!-- ================= 专精 C：对应医生的「化学家」=================
         原版主题是药物/毒素/配方。 -->
    <SubTree identifier="mcj_path_scientist" type="specialization"
             requires="mcj_astrologian_primary">
      <TalentOptions>
        <TalentOption identifier="plaguedoctor" />
      </TalentOptions>
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="deliverysystem" />
        <TalentOption identifier="labcontacts" />
      </TalentOptions>
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="supersoldiers" />
        <TalentOption identifier="whatastench" />
      </TalentOptions>
      <TalentOptions>
        <TalentOption identifier="macrodosing" />
      </TalentOptions>
    </SubTree>

  </TalentTree>

</TalentTrees>
