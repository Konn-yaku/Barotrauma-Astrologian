<?xml version="1.0" encoding="utf-8"?>
<!--
  占星术士 · 天赋树
  
  【当前状态】三条专精线：
    mcj_path_healing   —— 占星魔法（第一栏，已实装）
    mcj_path_arcanum   —— 奥秘卡（第二栏，已实装）
    mcj_path_astrolabe —— 会奶人的DPS（第三栏，4 档已全部实装）

  初级树 mcj_astrologian_primary 已于 2026-09-15 重做
  （构成见 Talents/AstrologianTalents.xml 初级树章节的注释）。

  ── 参数语义（来自官方 API 文档 BuildDocClient.xml）──
    TalentTree jobidentifier
        挂到哪个职业，必须和 Jobs 里的 identifier 一致
    SubTree type="primary" / "specialization"
        初级树开局可点；专精树需要 requires 指定的前置树
    SubTree blocks
        互斥：选了这条专精后，blocks 里列出的专精将无法再选
    TalentOptions requiredtalents
        官方定义："How many talents need to be unlocked to consider this tree completed"
        → 这一组需要点出几个天赋，才算完成本组（进而解锁下一组）
    TalentOptions maxchosentalents
        官方定义："How many talents can be unlocked in total"
        → 这一组最多能选几个
    ShowCaseTalent
        点击后展开的二选一入口（我们之后如果要"分支选择"就用它）
-->
<TalentTrees>

  <TalentTree jobidentifier="mcj_astrologian">

    <!-- ================= 初级：通用医疗兵基本功 + 占星专属 =================
         2026-09-16 结构改版 + 效果定稿：
           第 1 行：星图 / 星位合图 / 光速 / 大宇宙 / 康复
           第 2 行：本轮 / 星极 / 重力 / 生辰 / 吉星
         【本轮效果全部重写过，不再有任何一项是原版医生的拷贝】——
           光速：删掉了「队友拖拽不减速」（与「本轮」重复），只剩“有人昏迷时自己 +40% 移速”
           康复：由「即刻咏唱」改名而来，效果改成原版 medicalexpertise 的绷带强化
           生辰：由「全队 6 项抗性 +75%」改成“有人昏迷时自己 CPR +100%”
           重力：由“600 内全队 50% 眩晕抗性”改成“只给自己 30%”
           星极：层数上限由 20 层（+150%）降到 10 层（+100%）
           先天禀赋：×2.2 → ×1.5

         ⚠️ 初级树第 2 行第 5 位原本叫「占卜」，那个名字已让给第三栏的终档
            （FF14 的 Divination 就是全队增伤），这一位现在也是占位天赋。
         2026-09-16 二次变更：这一位上的「擢升」搬去了「占星魔法第 2 档」
            （ID 由 mcj_primary_divination 改为 mcj_exaltation），
            腾出的位子 2026-09-16 定稿为「吉星」mcj_primary_benefic（医疗技能 +30）。
         2 个占位天赋（第 1 行第 4 位 / 第 2 行第 5 位）已于同日全部定稿：
            第 1 行第 4 位 = 「大宇宙」mcj_primary_macrocosmos（每完成任务得 1 袋血袋）
         ⇒ 本模组不再有任何占位天赋。
         详情与理由写在 Talents/AstrologianTalents.xml 里。 -->
    <SubTree identifier="mcj_astrologian_primary" nameidentifier="talenttree.primary" type="primary">

      <TalentOptions requiredtalents="1" maxchosentalents="5">
        <TalentOption identifier="mcj_primary_starchart" />
        <TalentOption identifier="mcj_primary_synastry" />
        <TalentOption identifier="mcj_lightspeed" />
        <TalentOption identifier="mcj_primary_macrocosmos" />
        <TalentOption identifier="mcj_primary_esuna" />
      </TalentOptions>

      <TalentOptions requiredtalents="1" maxchosentalents="5">
        <TalentOption identifier="mcj_primary_epicycle" />
        <TalentOption identifier="mcj_primary_astral" />
        <TalentOption identifier="mcj_primary_starsounding" />
        <TalentOption identifier="mcj_primary_ascend" />
        <TalentOption identifier="mcj_primary_benefic" />
      </TalentOptions>

    </SubTree>

    <!-- ================= 专精 A：奥秘卡（第二栏 · 抽卡制）=================
         第 1 档「六天座」开启抽卡循环：
           天赋发一本抽卡书 → 右键抽出 3 张卡 → 60 秒后书变成另一极的书 →
           循环往复；书丢了或玩家死了，天赋会在 2 秒内补一本。
         第 2 档二选一：「重抽」（拆解产出概率翻倍）
                       「抽卡」（摸怪尸体拿基因材料 + 商店开卖基因材料）
         第 3 档：小奥秘卡（王冠之领主 / 王冠之贵妇）—— 已实装
         第 4 档「星力」：一轮 3 张卡全部打出后，给自己一份限时增益（只给自己）

         6 张卡的效果不再由天赋发放，而是【卡牌物品被拖到某人身上时】施加给那一个人。
         天赋实现见 Talents/AstrologianTalents.xml
         状态实现见 Afflictions/AstrologianAfflictions.xml -->
    <SubTree identifier="mcj_path_arcanum" type="specialization"
             requires="mcj_astrologian_primary">

      <!-- 第 1 档：六天座 -->
      <TalentOptions>
        <TalentOption identifier="mcj_arcanum_six" />
      </TalentOptions>

      <!-- 第 2 档：二选一 -->
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="mcj_arcanum_redraw" />
        <TalentOption identifier="mcj_arcanum_draw" />
      </TalentOptions>

      <!-- 第 3 档：小奥秘卡 —— 抽卡时额外给一张王冠卡（占第 4 格） -->
      <TalentOptions>
        <TalentOption identifier="mcj_arcanum_minor" />
      </TalentOptions>

      <!-- 第 4 档：星力 -->
      <TalentOptions>
        <TalentOption identifier="mcj_astrodyne" />
      </TalentOptions>

    </SubTree>

    <!-- ================= 专精 B：占星魔法（第一栏 · 治疗）=================
         「占星魔法」—— 占星术士最本职的一面，也是整个模组的第一支柱。
         4 层结构，第 2 层二选一，其余无选择 —— 与原版医生的「医生」子树同构。

         2026-09-16 定稿：
           第 1 档 吉星相位：施药给队友 10 秒持续缓愈（白昼相 · 单体）
           第 2 档二选一：先天禀赋（低血治疗 ×1.5）
                          / 擢升（600 内有队友时承伤 −15%；2026-09-16 从初级树搬来）
           第 3 档 阳星合相：600 内低血船员自动愈合（白昼相 · 范围）
           第 4 档 中间学派：两相同存（Neutral Sect）
                 · 给吉星相位补一份【单体黑夜相】= 施药时 +20% 生命上限、持续到巡回结束
                 · 给阳星合相补一份【群体黑夜相】= 600 内 +10% 生命上限 +5% 移速 光环
                 （后者的数值与原版医生 genetampering 完全相同，只多了 600 距离限制）

         ⇒ 白昼相（回复）由 1/3 档提供，黑夜相（生命上限）由 4 档给两个相各补一份。
         ⚠️ 原「天星交错」的效果已整体移交给中间学派。它的天赋位（第 2 档）
            现在给「擢升」——FF14 里擢升与先天禀赋同为占星术士常用的能力技，
            放在同一档二选一最自然。
         天赋实现见 Talents/AstrologianTalents.xml
         状态实现见 Afflictions/AstrologianAfflictions.xml -->
    <SubTree identifier="mcj_path_healing" type="specialization"
             requires="mcj_astrologian_primary">
      <!-- 第 1 档：吉星相位 -->
      <TalentOptions>
        <TalentOption identifier="mcj_aspectedbenefic" />
      </TalentOptions>

      <!-- 第 2 档：二选一 —— 先天禀赋 / 擢升 -->
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="mcj_essentialdignity" />
        <TalentOption identifier="mcj_exaltation" />
      </TalentOptions>

      <!-- 第 3 档：阳星合相 -->
      <TalentOptions>
        <TalentOption identifier="mcj_aspectedhelios" />
      </TalentOptions>

      <!-- 第 4 档：中间学派（效果待重新设计） -->
      <TalentOptions>
        <TalentOption identifier="mcj_primary_sect" />
      </TalentOptions>
    </SubTree>

    <!-- ================= 专精 C：会奶人的DPS（第三栏 · 作战输出）=================
         「会奶人的DPS」—— FF14 玩家对治疗职业的经典印象：
         本职工作是把人奶住，但一有空就得开输出。

         这条线就是一整条输出线：第 1 档直接发放「天球仪」——
         一件 smallitem 的手持远程武器，发射不消耗弹药的星光射线
         （见 Items/AstrologianItems.xml）。
         不给队友发任何团队 buff，完全靠自己打。

         第 2 档（两个都能选）：
           「焚灼」—— 燃烧伤害 +25%、对压载植物群 +50%
                      （照搬原版工程师「火焰狂人」 pyromaniac）
           「命运之轮」—— 你跪下来蓄力 5 秒后展开：600 范围内（含自己）
                          受到的伤害 −10%；起身后队友还保留约 5 秒。
                          用 AbilityGroupInterval 的 effectdelay 实现蓄力
                          （原版先例：助手「无害化」nonthreatening）。

         第 3 档「地星」—— 不做输出，做「预先布置」：
         放下一颗星，10 秒后待机，舱室一进水就自动修补船体并消失。
         （2026-09-15 从原第 2 档挪到第 3 档）

         第 4 档「占卜」—— 终档（2026-09-16 由「星河漫天」改名而来）：
         医疗技能 +45，自身伤害随医疗技能阶梯提升（最高 +30%）；
         你发出【远程攻击】时，1000 内的队友获得 +15% 伤害 / 20 秒，
         冷却 120 秒（冷却图标对玩家可见）。
         旧版的「击杀累积 20 层」已删除。 -->
    <SubTree identifier="mcj_path_astrolabe" type="specialization"
             requires="mcj_astrologian_primary">
      <!-- 第 1 档 -->
      <TalentOptions>
        <TalentOption identifier="mcj_astrolabe" />
      </TalentOptions>

      <!-- 第 2 档：焚灼 / 命运之轮（两个都能选）
           注：maxchosentalents="2" = 这一层最多可选 2 个 ⇒ 两个都拿得到。
           原版专精树里不写属性的 <TalentOptions> 才是单选。 -->
      <TalentOptions requiredtalents="1" maxchosentalents="2">
        <TalentOption identifier="mcj_combust" />
        <TalentOption identifier="mcj_wheeloffortune" />
      </TalentOptions>

      <!-- 第 3 档：地星（从原第 2 档挪来） -->
      <TalentOptions>
        <TalentOption identifier="mcj_earthlystar" />
      </TalentOptions>

      <!-- 第 4 档 -->
      <TalentOptions>
        <TalentOption identifier="mcj_divination" />
      </TalentOptions>
    </SubTree>

  </TalentTree>

</TalentTrees>
