<?xml version="1.0" encoding="utf-8"?>
<!--
  占星术士 · 自定义状态（buff）
  
  这些是"隐藏增益"，不会显示在伤口栏里，只作为天赋的实现载体。
  统一用 type="talentbuff" isbuff="true"。
  
  关键属性说明：
    hideiconafterdelay="true"  → 图标过一会自动隐藏，不占屏幕
    limbspecific="false"       → 不绑定具体肢体
    treatmentthreshold="1000"  → 极高，保证它不会被"治疗"掉
    resetbetweenrounds="true"  → 【持续一整个任务】的标准写法（原版只有 bedsidemanner 用了）
                                任务结束时自动清除，跨任务不残留
    iconcolors                 → buff 栏图标外侧的配色渐变
    <Icon>                     → 图标图片，指向 %ModDir%/Textures/Afflictions/ 下的本地素材
                                （这些图片不在仓库里，见 .gitignore）
                                color 写 255,255,255,255 = 不染色，保留原图配色
-->
<Afflictions>

  <!-- ============================================================
       初级树新增的 4 个光环 / 短时状态（2026-09-15）
       加上占星魔法第 1 层改版后的 mcj_benefic

       ⚠️ 抗性记法（重要）：这四条里的 resistancefor 用的都是【affliction 层】写法，
          数值 = 抗性本身（0.10 = 减 10%、0.5 = 减半、1.0 = 完全免疫）。
          这与天赋层 CharacterAbilityGiveResistance 的 multiplier（承伤倍率，
          0.9 = 只承受 90% = 减 10%）记法相反，两边不要互抄数字。
       ============================================================ -->

  <!-- 命运之轮（第三栏）：伤害 −10% 光环（duration 5 + 天赋每秒刷新）
       2026-09-15：本效果原本在初级树，与第三栏的技能光环对调后搬到这里。
       名字与 FF14 名实相符 —— Collective Unconscious 就是「站在你身边的队友少挨打」。
       2026-09-16：duration 由 3 秒改为 5 秒 —— 天赋改成了「蹲下满 5 秒才展开」，
                   所以队友需要靠这个时长在施术者起身后多保一段。 -->
  <Affliction identifier="mcj_wheeloffortune_ward"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="5"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 本模组唯一一条通用减伤。0.10 参照原版基因 damageresistance（10%~25%）的最低档。 -->
    <Effect minstrength="0" maxstrength="1" strengthchange="0"
            resistancefor="damage"
            minresistance="0.10"
            maxresistance="0.10" />
    <Icon texture="%ModDir%/Textures/Talents/WheelOfFortune.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- 中间学派 · 黑夜相（单体）—— 生命上限 +20%，持续到巡回结束
       2026-09-16：这份效果原本属于第 2 档「天星交错」，identifier 原为 mcj_primary_intersection。
       天星交错改为占位天赋后，效果整体移交给第 4 档「中间学派」。

       数值与写法照原版医生「维生素补充剂」vitaminsupplements → bedsidemanner
       （Content/Talents/Doctor/AfflictionsDoctor.xml）：
         · 不写 duration + strengthchange="0" + resetbetweenrounds="true"
           ⇒ 一次施药管一整局，巡回结束时自动清除
         · 天赋侧用 strength="600" + setvalue="true" 把强度拉满 -->
  <Affliction identifier="mcj_sect_shield"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" strengthchange="0">
      <StatValue stattype="MaximumHealthMultiplier" value="0.2" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Talents/NeutralSect.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- 生辰 · 急救模式（2026-09-16 定稿）—— 有人昏迷时给自己的心肺复苏加成

       旧版是「全图全队 6 项抗性 +75%」，铺得太开、与名字也对不上，已废弃。
       现在改成与「复活」名实相符的方向：心肺复苏。

       数值锚点：原版医生「冥土追魂」dontdieonme = CPRBoost 1（+100%），
                 只给自己、无条件常驻。我们加了「有人昏迷」这个条件
                 ⇒ 严格弱于原版。
       写法照原版医生「应急反应」emergencyresponse_selfbuff：
         duration="1"（天赋每 0.9 秒刷新）+ strengthchange="-1"
         + 四个 threshold 全 1000（不在 buff 栏显示） -->
  <Affliction identifier="mcj_ascend"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="1"
              showiconthreshold="1000"
              treatmentthreshold="1000"
              showicontoothersthreshold="1000"
              showinhealthscannerthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" strengthchange="-1">
      <StatValue stattype="CPRBoost" value="1.0" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Talents/Ascend.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- 重力：眩晕抗性 30%（2026-09-16 从 0.5 下调）
       原版 stun 抗性上限就是 0.5（Afflictions.xml），而 0.5 是「硬直减半」，
       对一个只作用于自己的初级树天赋来说太重了。
       锚点：原版船长「有备无患」battleready 就是 30%。 -->
  <Affliction identifier="mcj_primary_gravity"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="3"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" strengthchange="0"
            resistancefor="stun"
            minresistance="0.3"
            maxresistance="0.3" />
    <Icon texture="%ModDir%/Textures/Talents/StarSounding.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ❌ v0.13（2026-09-16）：「即刻咏唱」的 affliction 已随天赋重做删除
       它原本是给队友挂 1 秒的 CPRBoost 0.2（原版 stayinalive 的换皮）。
       该天赋已改名为「康复」并改成【绷带强化】—— 直接施加 StatusEffect，
       不经过 affliction，所以这一条没有任何引用者，已整段移除。 -->

  <!-- ===== 占星魔法 · 光速：队友拖拽角色不减速（2026-09-15） =====
       由 mcj_lightspeed 每秒给全图队友刷新。
       ⚠️ AbilityFlag 会随 affliction 到期失效 —— 原版医生「应急反应」
          emergencyresponse 就是用 0.9 秒刷新的短 affliction 给助手挂这个 flag 的
          （它只对 jobs="assistant" 生效，我们不写 jobs = 全队）。 -->
  <Affliction identifier="mcj_lightspeed_grant"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="1"
              showiconthreshold="1000"
              treatmentthreshold="1000"
              showicontoothersthreshold="1000"
              showinhealthscannerthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <AbilityFlag flagtype="MoveNormallyWhileDragging" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Talents/Lightspeed.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       吉星相位（占星魔法第 1 层）—— 施药给队友 10 秒持续缓愈
       来源天赋：mcj_celestialopposition

       2026-09-15 重做：原为「天星交错 / 生命上限 +20%」（100% 拷贝原版 bedsidemanner），
       与初级树的同名天赋重叠，已改为名实相符的持续治疗。

       ⚠️ 数值刻意保守：这是【常驻每次施药都触发】的持续回复，
          1 秒共 reduce damage 0.5 / bleeding 0.2；
          对比阳星合相（只在 <20% 生命时生效）是 0.75/0.2 每秒，量级相当。
       ============================================================ -->
  <Affliction identifier="mcj_benefic"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="10"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <StatusEffect target="Character" interval="0.1" disabledeltatime="true">
        <ReduceAffliction type="damage" amount="0.05" />
        <ReduceAffliction type="bleeding" amount="0.02" />
      </StatusEffect>
    </Effect>
    <Icon texture="%ModDir%/Textures/Talents/AspectedBenefic.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       阳星合相 —— 濒危时的自动愈合
       来源天赋：mcj_aspectedhelios

       2026-09-16 改版（第四次）：从「止血」改成「疗伤」。
         · 只有角色【生命值低于 40%】时才会生效 —— 高于 40% 完全不作用。
         · 生效时每 0.1 秒清除 0.15 点 type="damage" ⇒ 【每秒 1.5 点伤势】。
           1.5 是刻意选的：原版绷带（Content/Items/Medical/medical.xml 的
           antibleeding1）底子就是 bleeding 1.5/秒 ⇒ 本天赋 =「自动绷带」。

       【实际观感】它把 40% 生命值变成一条会自动爬回去的底线 ——
         掉到 40% 以下就每秒回 1.5 点，爬回 40% 自动停。
         按生命上限 100 估算：1% → 40% 约 26 秒；20% → 40% 约 13 秒。
         是「安全网」，不是「急救」—— 它救不回正在被持续输出的人。

       ⚠️ 它【只】清 type="damage"（枪伤 / 咬伤 / 钝击 / 撕裂 / 深层组织损伤）。
          流血、失血、烧伤一概无效 —— 刻意如此。
          有人流血掉到 40% 以下时，它只会在回伤势的同时任由流血继续扣，
          所以【流血致死它救不了】—— 那一块交给「康复」（绷带强化）去管。
          「自动清流血」被明确否决：流血必须留给药物，否则会架空整个医疗循环。
       ⚠️ 旧版清 bleeding/burn/bloodloss 的三条已全部删除。
       ============================================================ -->
  <Affliction identifier="mcj_helios"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="2"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <StatusEffect target="Character" interval="0.1" disabledeltatime="true">
        <Conditional healthpercentage="lt 40" />
        <ReduceAffliction type="damage" amount="0.15" />
      </StatusEffect>
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/HeliosConjunction.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       星天开门 —— 护身符（每人一份，濒死时自动消耗）
       来源天赋：mcj_stargate

       2026-09-15 改版：效果换成【安全官最终技「不屈」implacable 同款的短时间免死】。
       原版实现（Content/Talents/Security/TalentsSecurity.xml:522）：
         AbilityGroupInterval maxtriggercount="1"            ← 每任务只触发一次
         AbilityConditionAboveVitality invert="true"          ← 活力跌破阈值
         → 给自己挂 implacable 15 秒（AlwaysStayConscious + AttackMultiplier 0.25）
       我们把它从「天赋侧自检」改成「护身符自检」，
       以便保持原来「全船每人各自一张」的结构。

       【新的流程】
         身上带符 → 活力低于 1% 时：先给自己挂 15 秒的 mcj_stargate_grace，
                     再把自己的符烧掉。
         每个人各自独立判断、只消耗触发那个人的那一张。

       【为什么不再用 isunconscious 触发】
         以前是「倒地后满血」，现在是「倒地前免死」——
         必须在昏迷发生【之前】介入，所以改成纯阈值判定。
         阈值与原版完全一致：都是 1% 活力。
         ⚠️ 单位陷阱：原版天赋写的是 vitalitypercentage="0.01"（小数，= 1%），
            而这里用的是 healthpercentage="lt 1"（百分数，= 1%）——
            两套单位不同，别把 0.01 直接搬过来。

       minstrength="0.1"：符被烧掉后强度归 0，其 Effect 全部失效。
       这是刻意设计的安全阀 —— 单纯用 -9999 删除自身有一定风险。

       resetbetweenrounds="true"：任务结束自动清符，下个任务重发。
       ⚠️ 护身符本身不再带 CanNotDieToAfflictions —— 免死改由 grace 那边的
          AlwaysStayConscious 承担（原版 implacable 同款），符只是个开关。
       ============================================================ -->
  <Affliction identifier="mcj_stargate"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 强度 > 0.1：护身符待触发 -->
    <Effect minstrength="0.1" maxstrength="1">
      <StatusEffect target="Character" interval="0.05" disabledeltatime="true">
        <!-- 生命值低于 1%：与原版 implacable 的阈值一致，最后一刻触发 -->
        <Conditional healthpercentage="lt 1" />
        <!-- ① 先给自己 15 秒免死（写在前面，同一 tick 内就生效） -->
        <Affliction identifier="mcj_stargate_grace" amount="1" />
        <!-- ② 再烧掉护身符（强度 1 → 0） -->
        <Affliction identifier="mcj_stargate" amount="-1" />
      </StatusEffect>
    </Effect>
    <!-- 强度 = 0：护身符已被烧掉，什么都不做 -->
    <Effect minstrength="0" maxstrength="0.1" />
    <Icon texture="%ModDir%/Textures/Afflictions/Stargate.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ===== 星天开门的免死状态：不屈（15 秒） =====
       数值与结构完全照搬原版安全官最终技 implacable
       （Content/Talents/Security/AfflictionsSecurity.xml:70）：
         AlwaysStayConscious   = 15 秒内不会昏迷 —— 这就是「短时间免死」的本体
         AttackMultiplier 0.25 = 临死反扑，伤害 +25%
       原版 implacable 写的是 maxstrength="15" + duration="15"；
       我们只需要固定强度，所以 maxstrength="1"、Effect 区间 0~1。
       ⚠️ 它与本模组的太阳神之衡（AttackMultiplier 0.40）会相加，这是有意为之。 -->
  <Affliction identifier="mcj_stargate_grace"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="15"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <AbilityFlag flagtype="AlwaysStayConscious" />
      <StatValue stattype="AttackMultiplier" value="0.25" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/Stargate.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ===== 焚灼的火焰抗性（第 2 档天赋给的常驻 buff） =====
       由天赋 mcj_combust 发放，无 duration + resetbetweenrounds="true"
       ⇒ 持续一整个巡回，巡回结束时自动清除。

       ⚠️ resistancefor="burn" 原版无先例 —— 原版只用过 damage / stun / oxygenlow。
          依据是 burn 确实是一个独立的 AfflictionType
          （原版 <Burn identifier="burn" type="burn">，acidburn 与 burning 也是 type="burn"），
          而 resistancefor 就是按类型匹配的。待实测确认。
       ⚠️ resistancefor 只折减【新获得】的量，不能清除已经烧起来的伤。 -->
  <Affliction identifier="mcj_combust_ward"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 2026-09-16 定档：0.5 → 0.2。
         锚点：原版工程师「接地」grounded 就是 burn 抗性 20%
         （CharacterAbilityGiveResistance resistanceid="burn" multiplier="0.8"）。
         之前给 0.5 是「免疫一半火焰」，对一个兼职输出的天赋来说太重了。 -->
    <Effect minstrength="0" maxstrength="1"
            strengthchange="0"
            resistancefor="burn"
            minresistance="0.2"
            maxresistance="0.2" />
    <Icon texture="%ModDir%/Textures/Talents/Combust.png" sourcerect="0,0,80,80" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       第二栏 · 奥秘卡 —— 打出后给全队 15 秒的限时增益
       来源：六天座（Talents/AstrologianTalents.xml）里的卡片广播组

       【链路】卡打出（物品）→ 只给使用者上一个 2 秒的「信号弹」affliction
               → 天赋每 0.5 秒轮询，看到信号就广播真正的 buff 给全队，再清掉信号。

       【数值基准】每张卡只持续 15 秒（覆盖率 25%），属于"短时爆发"而不是常驻，
       所以统一按「原版对应锚点 × 1.5~1.6」定档，比原版常驻天赋给得更足。
       2026-09 定档：攻速 0.50 / 0.30（原版天花板 0.30 / 0.20）。

       【三类效果】
         · 数值型：StatValue（伤害 / 攻速 / 机动 / 工程）
         · 抗性型：resistancefor + minresistance/maxresistance ——
           只折减【新获得】的量，且原版只有 damage / stun / oxygenlow 三种先例。
         · 治疗型：Effect 内嵌 <StatusEffect target="Character"> + <ReduceAffliction>，
           走的是原版 combatstimulant / pressurestabilized 的范式。
       世界树之干（抗眩晕 + 持续愈合）与河流神之瓶（无需氧气）用第 2+3 类实现，
       刻意不做 damage 抗性 —— 本模组不提供伤害减免。

       【显示】6 张卡是【可见】的 —— 用图标本身告诉玩家"哪几张卡正在生效"。
       隐藏三件套（showiconthreshold / showicontoothersthreshold /
       showinhealthscannerthreshold）在 6 个 _sig_* 信号弹上全部设成 "1000"
       （原版 melodicrespite_charging 的写法），保证 buff 栏里只看得到真正的卡片。
       ============================================================ -->

  <!-- ===== 太阳神之衡：全队增伤（15 秒） =====
       真正的增益由「六天座」广播组施加（含自己、无视距离）。 -->
  <Affliction identifier="mcj_balance"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="15"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 2026-09 定档：0.40。
         原版 AttackMultiplier 天花板是 0.25（TE 的暴力军阀 warlord 是 0.1/层、
         五层封顶 0.5）。本卡只持续 15 秒（覆盖率 25%），按「原版锚点 × 1.6」取 0.40。 -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="AttackMultiplier" value="0.40" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/Balance.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ── 「太阳神之衡」的信号弹 ──
       卡打出时只给【使用者自己】上这一条 2 秒的隐形标记，
       真正的团队增益由「六天座」广播组施加（Talents/AstrologianTalents.xml）。
