<?xml version="1.0" encoding="utf-8"?>
<!--
  占星术士 · 自定义状态（buff）
  
  这些是"隐藏增益"，不会显示在伤口栏里，只作为天赋的实现载体。
  统一用 type="talentbuff" isbuff="true"。
  
  关键属性说明：
    hideiconafterdelay="true"  → 图标过一会自动隐藏，不占屏幕
    limbspecific="false"       → 不绑定具体肢体
    treatmentthreshold="1000"  → 极高，保证它不会被"治疗"掉
    resetbetweenrounds="true"  → 【持续一整个任务】的标准写法（原版只有 bedsidemanner 用了）
                                任务结束时自动清除，跨任务不残留
    iconcolors                 → buff 栏图标外侧的配色渐变
    <Icon>                     → 图标图片，指向 %ModDir%/Textures/Afflictions/ 下的本地素材
                                （这些图片不在仓库里，见 .gitignore）
                                color 写 255,255,255,255 = 不染色，保留原图配色
-->
<Afflictions>

  <!-- ============================================================
       天星交错 —— 被治疗的队友获得生命上限提升，持续一整个任务
       来源天赋：mcj_celestialopposition
       ============================================================ -->
  <Affliction identifier="mcj_opposition"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 生命上限 +20% —— 原版医生「健康典范」exampleofhealth 的数值
         （CharacterAbilityGiveStat MaximumHealthMultiplier 0.2；
           原版还有 bedsidemanner 同样 0.2、genetampering 0.10）。
         这里是“被治疗后才生效”的常驻 buff。
         ⚠️ 生命上限是乘算的：效果到期时上限回落，若此时活力高于新上限会被截断
            —— 那只是少一点缓冲，不会扣血。 -->
    <Effect minstrength="0" maxstrength="1" strengthchange="0">
      <StatValue stattype="MaximumHealthMultiplier" value="0.2" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/Opposition.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       阳星合相 —— 范围内队友的伤害不会继续加深
       来源天赋：mcj_aspectedhelios
       
       2026-09 改版：不再是「持续自愈」（HOT），改成阻止新伤害。
       实现是 resistancefor="damage" 拉满 1.0 —— 范围内队友不再受到新的
       damage 类伤害（枪伤 / 咬伤 / 爆炸 / 水压…），但也【不治疗】已经形成的伤势。
       ⚠️ 流血(bleeding)、烧灼(burn)、缺氧(oxygenlow) 是独立类型，
          不在 damage 之下，所以这个光环挡不住它们。
       ⚠️ resistancefor 只能写上 buff 之前新受到的伤害；
          已经有伤的人不会因此变轻 —— 这正是“不再加深而不是变好”的设计意图。
       ============================================================ -->
  <Affliction identifier="mcj_helios"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="2"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" strengthchange="0"
            resistancefor="damage"
            minresistance="1"
            maxresistance="1" />
    <Icon texture="%ModDir%/Textures/Afflictions/Helios.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       星天开门 —— 护身符（每人一份，濒死时自动消耗）
       来源天赋：mcj_stargate
       
       对应 FF14 中治疗职业的 3 段极限技「星天开门」（全体复活 + 满血）。
       潜渊症做不到"复活死者"，所以这里实现为"濒死时自动满血"。
       
       【核心思路】把"消耗"做进 buff 自身，而不是靠天赋去检测。
       每个船员身上各挂一份，各自独立判断自己的状态：
         身上带符 → 不会因伤痛死亡
         自己倒地（失去知觉）→ 一次性恢复到满血，同时把自己的符烧掉
       这样天然就是"只消耗触发那个人的"，而且不需要任何外部检测。
       
       【触发条件为什么是两个】
         isunconscious="true"       → 真正的"倒地"。比 healthpercentage 精确：
                                       旧写法 <10% 会在角色还剩 9% 血、
                                       还站着的时候就把符烧掉。
         healthpercentage="lt 30"   → 保险栓。避免"因眩晕等其他原因被判定为
                                       失去知觉"时白烧一张符。
         两者用 ConditionalComparison="And" 组合（原版 25 处在用）。
       若实测发现护身符从不触发，先把 healthpercentage 那一行删掉试试。
       
       满血的实现：潜渊症没有"回血"，所谓满血 = 把决定血条的状态全部清零。
       伤害(damage) 是总类，但烧灼/出血/失血不在它下面，必须分列。
       其中 amount=100 是超过上限的值，确保一次清干净。
       出血与失血必须一并清，否则刚回满就会被连锁反应重新拉下去。
       
       minstrength="0.1"：符被烧掉后强度归 0，AbilityFlag 就不再生效。
       这是刻意设计的安全阀——单纯用 -9999 删除自身有一定风险。
       
       resetbetweenrounds="true"：任务结束自动清符，下个任务重发。
       ============================================================ -->
  <Affliction identifier="mcj_stargate"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 强度 > 0.1：护身符已激活 -->
    <Effect minstrength="0.1" maxstrength="1">
      <!-- ① 免死 -->
      <AbilityFlag flagtype="CanNotDieToAfflictions" />
      <!-- ② 自己倒地时：恢复满血，并把护身符烧掉
           检测间隔从 0.2 缩到 0.05 —— 因为水压一类"瞬时致死"的伤害
           每帧就能扣 10 点活力，0.2 秒的间隔根本追不上。 -->
      <StatusEffect target="Character" interval="0.05" disabledeltatime="true" ConditionalComparison="And">
        <!-- 真正的倒地（失去知觉） -->
        <Conditional isunconscious="true" />
        <!-- 保险栓：确保确实是伤重而倒，而非瞬时眩晕 -->
        <Conditional healthpercentage="lt 30" />
        <!-- 伤害总类（含撕裂伤/钝器伤/枪伤/咬伤/内伤等） -->
        <ReduceAffliction type="damage" amount="100" />
        <!-- 烧灼不在 damage 下面，单列 -->
        <ReduceAffliction type="burn" amount="100" />
        <!-- 出血→失血→伤害是连锁反应，必须一起清 -->
        <ReduceAffliction type="bleeding" amount="100" />
        <ReduceAffliction identifier="bloodloss" amount="100" />
        <!-- 强度 1 → 0，护身符失效（不再给任何免死） -->
        <Affliction identifier="mcj_stargate" amount="-1" />
      </StatusEffect>
    </Effect>
    <!-- 强度 = 0：护身符已被烧掉，什么都不做 -->
    <Effect minstrength="0" maxstrength="0.1" />
    <Icon texture="%ModDir%/Textures/Afflictions/Stargate.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       第二栏 · 奥秘卡 —— 打出后给全队 15 秒的限时增益
       来源：六天座（Talents/AstrologianTalents.xml）里的卡片广播组

       【链路】卡打出（物品）→ 只给使用者上一个 2 秒的「信号弹」affliction
               → 天赋每 0.5 秒轮询，看到信号就广播真正的 buff 给全队，再清掉信号。

       【数值基准】每张卡只持续 15 秒（覆盖率 25%），属于"短时爆发"而不是常驻，
       所以统一按「原版对应锚点 × 1.5~1.6」定档，比原版常驻天赋给得更足。
       2026-09 定档：攻速 0.50 / 0.30（原版天花板 0.30 / 0.20）。

       【三类效果】
         · 数值型：StatValue（伤害 / 攻速 / 机动 / 工程）
         · 抗性型：resistancefor + minresistance/maxresistance ——
           只折减【新获得】的量，且原版只有 damage / stun / oxygenlow 三种先例。
         · 治疗型：Effect 内嵌 <StatusEffect target="Character"> + <ReduceAffliction>，
           走的是原版 combatstimulant / pressurestabilized 的范式。
       世界树之干（抗眩晕 + 持续愈合）与河流神之瓶（无需氧气）用第 2+3 类实现，
       刻意不做 damage 抗性 —— 本模组不提供伤害减免。

       【显示】6 张卡是【可见】的 —— 用图标本身告诉玩家"哪几张卡正在生效"。
       隐藏三件套（showiconthreshold / showicontoothersthreshold /
       showinhealthscannerthreshold）在 6 个 _sig_* 信号弹上全部设成 "1000"
       （原版 melodicrespite_charging 的写法），保证 buff 栏里只看得到真正的卡片。
       ============================================================ -->

  <!-- ===== 太阳神之衡：全队增伤（15 秒） =====
       真正的增益由「六天座」广播组施加（含自己、无视距离）。 -->
  <Affliction identifier="mcj_balance"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="15"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 2026-09 定档：0.40。
         原版 AttackMultiplier 天花板是 0.25（TE 的暴力军阀 warlord 是 0.1/层、
         五层封顶 0.5）。本卡只持续 15 秒（覆盖率 25%），按「原版锚点 × 1.6」取 0.40。 -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="AttackMultiplier" value="0.40" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/Balance.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ── 「太阳神之衡」的信号弹 ──
       卡打出时只给【使用者自己】上这一条 2 秒的隐形标记，
       真正的团队增益由「六天座」广播组施加（Talents/AstrologianTalents.xml）。
       这样 6 张卡只需要维护一份数值，不会出现"自己一份、队友一份"的数值漂移。 -->
  <Affliction identifier="mcj_sig_balance"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              showiconthreshold="1000"
              showicontoothersthreshold="1000"
              showinhealthscannerthreshold="1000"
              limbspecific="false"
              maxstrength="1"
              duration="2"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" />
    <Icon texture="%ModDir%/Textures/Afflictions/Balance.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ===== 战争神之枪：全队攻击速度（15 秒） ===== -->
  <Affliction identifier="mcj_spear"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="15"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 2026-09 定档：近战 0.50 / 远程 0.30。
         原版天花板就是 MeleeAttackSpeed 0.30、RangedAttackSpeed 0.20
         （舰长 battleready 和医生 combatstimulant 用的正是这两个值）。
         本卡只持续 15 秒（覆盖率 25%），所以给到原版天花板的约 1.6 倍。 -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="MeleeAttackSpeed" value="0.50" />
      <StatValue stattype="RangedAttackSpeed" value="0.30" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/Spear.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ── 「战争神之枪」的信号弹 ── -->
  <Affliction identifier="mcj_sig_spear"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              showiconthreshold="1000"
              showicontoothersthreshold="1000"
              showinhealthscannerthreshold="1000"
              limbspecific="false"
              maxstrength="1"
              duration="2"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" />
    <Icon texture="%ModDir%/Textures/Afflictions/Spear.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ===== 放浪神之箭：全队移动速度与游泳速度（15 秒） ===== -->
  <Affliction identifier="mcj_arrow"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="15"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 2026-09 定档：移速 0.35 / 泳速 0.50。
         WalkingSpeed / SwimmingSpeed 就是原版两个速度基因用的 stat，
         原版区间是 0.10~0.25 与 0.10~0.50 —— 泳速直接取到原版天花板，
         因为水下地图里泳速的权重远高于移速。 -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="WalkingSpeed" value="0.35" />
      <StatValue stattype="SwimmingSpeed" value="0.50" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/Arrow.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ── 「放浪神之箭」的信号弹 ── -->
  <Affliction identifier="mcj_sig_arrow"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              showiconthreshold="1000"
              showicontoothersthreshold="1000"
              showinhealthscannerthreshold="1000"
              limbspecific="false"
              maxstrength="1"
              duration="2"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" />
    <Icon texture="%ModDir%/Textures/Afflictions/Arrow.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ===== 世界树之干：全队抗眩晕 + 持续愈合（15 秒） =====
       照原版医生「战斗兴奋剂」combatstimulant（Content/Talents/Doctor/AfflictionsDoctor.xml:5）改写。
       官方对该效果的描述是「让使用者快速从身体损伤与失血中恢复」，
       它的实现正好就是「抗眩晕 + 每 0.1 秒持续治疗」这两件东西。

       · resistancefor="stun" 0.5 = 新受到的眩晕量折减一半。
         stun 的强度【就是眩晕秒数】（王冠卡的爆炸写的是 stun 7 = 7 秒硬直），
         所以这是「硬直时间减半」，不是免疫，也不影响已经中的那一段。
         原版用例：舰长 battleready 0.3、医生 combatstimulant 0.45 / 0.5。
       · 内嵌 <StatusEffect target="Character"> + <ReduceAffliction>：每 0.1 秒
         回 0.15 点损伤 / 失血 / 流血 = 1.5 点每秒，15 秒合计约 22 点。
         原版 combatstimulant 满档是 2 点每秒（单体），我们覆盖全队所以略低。

       ⚠️ 刻意不碰 resistancefor="damage" —— 本模组不做伤害减免。
       ⚠️ 「物品/能力给角色施加一个自带内嵌效果的 affliction」这条路是有原版先例的：
          战斗兴奋剂注射器就是用 <Affliction identifier="combatstimulant" amount="15.0"/>
          发出它的（Content/Items/Jobgear/Medic/medic_talent_items.xml:83），
          所以六天座的广播组发 mcj_bole 走的是同一套逻辑。
       ⚠️ 内嵌 StatusEffect 必须带 interval + disabledeltatime="true"（真实时间），
          否则进站点/巡回重建时会跟着游戏内时间一起停摆。 -->
  <Affliction identifier="mcj_bole"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="15"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1"
            strengthchange="0"
            resistancefor="stun"
            minresistance="0.5"
            maxresistance="0.5">
      <StatusEffect target="Character" interval="0.1" disabledeltatime="true">
        <ReduceAffliction type="damage" strength="0.15" />
        <ReduceAffliction identifier="bloodloss" strength="0.15" />
        <ReduceAffliction identifier="bleeding" strength="0.15" />
      </StatusEffect>
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/Bole.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ── 「世界树之干」的信号弹 ── -->
  <Affliction identifier="mcj_sig_bole"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              showiconthreshold="1000"
              showicontoothersthreshold="1000"
              showinhealthscannerthreshold="1000"
              limbspecific="false"
              maxstrength="1"
              duration="2"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" />
    <Icon texture="%ModDir%/Textures/Afflictions/Bole.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ===== 建筑神之塔：全队修理速度与修船壳速度（15 秒） ===== -->
  <Affliction identifier="mcj_spire"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="15"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 2026-09 定档：0.50 / 0.50（= 原版工程师常驻天赋 stationengineer 的顶配值）。
         RepairSpeed = 通用修理速度（机械 + 电器一起覆盖）
         RepairToolStructureRepairMultiplier = 修船壳速度
         修理是持续工程量而不是瞬时爆发，所以不再往上堆 —— 0.50 已有原版先例。 -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="RepairSpeed" value="0.50" />
      <StatValue stattype="RepairToolStructureRepairMultiplier" value="0.50" />
    </Effect>
    <Icon texture="%ModDir%/Textures/Afflictions/Spire.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ── 「建筑神之塔」的信号弹 ── -->
  <Affliction identifier="mcj_sig_spire"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              showiconthreshold="1000"
              showicontoothersthreshold="1000"
              showinhealthscannerthreshold="1000"
              limbspecific="false"
              maxstrength="1"
              duration="2"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1" />
    <Icon texture="%ModDir%/Textures/Afflictions/Spire.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

  <!-- ===== 河流神之瓶：全队无需氧气（15 秒） =====
       照原版医生「压力稳定」pressurestabilized（Content/Talents/Doctor/AfflictionsDoctor.xml:44）改写。
       官方对该效果的描述是：
         "The subject is immune to pressure and has no need for oxygen at this time."
       ——「不需要氧气」这句话对应的实现，就是
          resistancefor="oxygenlow" 直接拉到 1.0（minresistance=maxresistance="1"）。

       · 抗性 1.0 = 缺氧【完全不累积】 ⇒ 不用氧气瓶、无氧环境里也能正常活动。
       · 抗性只折减「新获得」的量，所以原版还额外挂了一条持续清除
         （每 tick 减 0.5 缺氧）。我们照抄这条双保险，
         把「刚断氧那一刻」残留的那点缺氧一起清掉。 -->
