  <!-- ===== 第三栏 · 命运之轮：高额减伤 + 持续治疗 =====
       由投掷物 mcj_wheeloffortune 落地时施加，持续 20 秒。
       它是一个「限时」buff，所以没有 resetbetweenrounds，改用 duration 自动消退。 -->
  <Affliction identifier="mcj_wheeloffortune"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="20"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">

    <!-- 一、减伤：固定 65%。
         对标 TE `Repairandreinforcement` 维修加固的中高档（resistance 0.25→0.65）。
         （原版 `resistancefor="damage"` 的上限是 0.5，本模组在这里刻意高于原版，
           因为玩家要求整体强度对标 TE；代价是只持续 20 秒且靠消耗品触发。） -->
    <Effect minstrength="0" maxstrength="1"
            strengthchange="0"
            resistancefor="damage"
            minresistance="0.65"
            maxresistance="0.65" />

    <!-- 二、治疗：持续 20 秒。
         速率 3.75 / 秒 —— 对照本模组的阳星合相（0.75 / 秒）是 5 倍，
         也与 TE `Repairandreinforcement` 的 3 / 秒 同一量级。
         理论总量 = 约 75 点伤害 + 25 点出血，但那需要你活满 20 秒；
         潜渊症战斗节奏很短，实战里能回上二三十点已经很好了。
         觉得总量太高就把 amount 减半（速率减半，总量约 37 点）。 -->
    <Effect minstrength="0" maxstrength="1">
      <StatusEffect target="Character" interval="0.1" disabledeltatime="true">
        <ReduceAffliction type="damage" amount="0.375" />
        <ReduceAffliction type="bleeding" amount="0.125" />
      </StatusEffect>
    </Effect>

    <Icon texture="%ModDir%/Textures/Afflictions/WheelOfFortune.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
  </Affliction>

