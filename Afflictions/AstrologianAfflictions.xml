              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="4"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 对标 TE「暴力军阀 warlord」0.1→0.5。队友只拿“小份”，所以取 10%。 -->
