<!--
  占星术士 · 自定义状态（buff）
  
  这些是"隐藏增益"，不会显示在伤口栏里，只作为天赋的实现载体。
  统一用 type="talentbuff" isbuff="true"。
  
  关键属性说明：
    hideiconafterdelay="true"  → 图标过一会自动隐藏，不占屏幕
    limbspecific="false"       → 不绑定具体肢体
    treatmentthreshold="1000"  → 极高，保证它不会被"治疗"掉
    resetbetweenrounds="true"  → 【持续一整个任务】的标准写法（原版只有 bedsidemanner 用了）
                                任务结束时自动清除，跨任务不残留
    iconcolors                 → 图标配色，沿用原版天赋 buff 的那一套青色
-->
<Afflictions>

  <!-- ============================================================
       天星交错 —— 被治疗的队友获得全伤害抗性，持续一整个任务
       来源天赋：mcj_celestialopposition
       ============================================================ -->
  <Affliction identifier="mcj_opposition"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 固定 15% 全伤害抗性（minresistance = maxresistance 即固定值） -->
    <Effect minstrength="0" maxstrength="1"
            strengthchange="0"
            resistancefor="damage"
            minresistance="0.15"
            maxresistance="0.15" />
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="2,5" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       阳星合相 —— 潜艇内队友持续缓慢自愈
       来源天赋：mcj_aspectedhelios
       
       数值直接复刻【锤头鲨母皇基因】的最强档（原版 healdamage，强度 80~100）：
           每 0.1 秒  damage -0.075 / bleeding -0.02
       换算：每秒 damage -0.75，回满 100 点伤害需要 130+ 秒。
       它慢，但全自动、无需选药、同时处理伤害与出血。
       ============================================================ -->
  <Affliction identifier="mcj_helios"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="2"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <StatusEffect target="Character" interval="0.1" disabledeltatime="true">
        <ReduceAffliction type="damage" amount="0.075" />
        <ReduceAffliction type="bleeding" amount="0.02" />
      </StatusEffect>
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="1,5" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       星天开门 —— 护身符（每人一份，濒死时自动消耗）
       来源天赋：mcj_stargate
       
       对应 FF14 中治疗职业的 3 段极限技「星天开门」（全体复活 + 满血）。
       潜渊症做不到"复活死者"，所以这里实现为"濒死时自动满血"。
       
       【核心思路】把"消耗"做进 buff 自身，而不是靠天赋去检测。
       每个船员身上各挂一份，各自独立判断自己的状态：
         身上带符 → 不会因伤痛死亡
         自己倒地（失去知觉）→ 一次性恢复到满血，同时把自己的符烧掉
       这样天然就是"只消耗触发那个人的"，而且不需要任何外部检测。
       
       【触发条件为什么是两个】
         isunconscious="true"       → 真正的"倒地"。比 healthpercentage 精确：
                                       旧写法 <10% 会在角色还剩 9% 血、
                                       还站着的时候就把符烧掉。
         healthpercentage="lt 30"   → 保险栓。避免"因眩晕等其他原因被判定为
                                       失去知觉"时白烧一张符。
         两者用 ConditionalComparison="And" 组合（原版 25 处在用）。
       若实测发现护身符从不触发，先把 healthpercentage 那一行删掉试试。
       
       满血的实现：潜渊症没有"回血"，所谓满血 = 把决定血条的状态全部清零。
       伤害(damage) 是总类，但烧灼/出血/失血不在它下面，必须分列。
       其中 amount=100 是超过上限的值，确保一次清干净。
       出血与失血必须一并清，否则刚回满就会被连锁反应重新拉下去。
       
       minstrength="0.1"：符被烧掉后强度归 0，AbilityFlag 就不再生效。
       这是刻意设计的安全阀——单纯用 -9999 删除自身有一定风险。
       
       resetbetweenrounds="true"：任务结束自动清符，下个任务重发。
       ============================================================ -->
  <Affliction identifier="mcj_stargate"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 强度 > 0.1：护身符已激活 -->
    <Effect minstrength="0.1" maxstrength="1">
      <!-- ① 免死 -->
      <AbilityFlag flagtype="CanNotDieToAfflictions" />
      <!-- ② 自己倒地时：恢复满血，并把护身符烧掉
           检测间隔从 0.2 缩到 0.05 —— 因为水压一类"瞬时致死"的伤害
           每帧就能扣 10 点活力，0.2 秒的间隔根本追不上。 -->
      <StatusEffect target="Character" interval="0.05" disabledeltatime="true" ConditionalComparison="And">
        <!-- 真正的倒地（失去知觉） -->
        <Conditional isunconscious="true" />
        <!-- 保险栓：确保确实是伤重而倒，而非瞬时眩晕 -->
        <Conditional healthpercentage="lt 30" />
        <!-- 伤害总类（含撕裂伤/钝器伤/枪伤/咬伤/内伤等） -->
        <ReduceAffliction type="damage" amount="100" />
        <!-- 烧灼不在 damage 下面，单列 -->
        <ReduceAffliction type="burn" amount="100" />
        <!-- 出血→失血→伤害是连锁反应，必须一起清 -->
        <ReduceAffliction type="bleeding" amount="100" />
        <ReduceAffliction identifier="bloodloss" amount="100" />
        <!-- 强度 1 → 0，护身符失效（不再给任何免死） -->
        <Affliction identifier="mcj_stargate" amount="-1" />
      </StatusEffect>
    </Effect>
    <!-- 强度 = 0：护身符已被烧掉，什么都不做 -->
    <Effect minstrength="0" maxstrength="0.1" />
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="7,5" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <!-- ============================================================
       第二栏 · 奥秘卡（全队常驻增益）
       来源天赋：mcj_path_arcanum

       【结构】6 张卡 = 6 个基础 affliction + 6 个 _boost affliction。
       「星力」天赋会在你拥有某张卡天赋时，额外给全队施加对应的 _boost。
       两个 affliction 的 StatValue 会自然相加 —— 这就是"星力放大卡牌效果"的实现。

       【为什么不用"抬高同一个 affliction 的强度"】
       GiveAffliction 的数值是往 maxstrength 上限累加的，
       基础值和强化值最终都会饱和到同一个上限，区分不出来。
       两个不同的 affliction 相加则没有这个问题。

       【数值】全部落在 {0.15, 0.20, 0.30}，_boost 只有 {0.05, 0.10}。
       每一项都低于原版对应的天赋/基因数值（见 README）。
       ============================================================ -->

  <!-- ===== 太阳神之衡：全队增伤 ===== -->
  <Affliction identifier="mcj_balance"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 原版参照：安全官 implacable / tandemfire 为 0.25 / 0.20（限时·仅自己） -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="AttackMultiplier" value="0.15" />
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="0,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <Affliction identifier="mcj_balance_boost"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="AttackMultiplier" value="0.05" />
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="0,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <!-- ===== 战争神之枪：全队攻击速度 ===== -->
  <Affliction identifier="mcj_spear"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 原版参照：舰长天赋 0.30 / 0.20 -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="MeleeAttackSpeed" value="0.20" />
      <StatValue stattype="RangedAttackSpeed" value="0.15" />
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="1,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <Affliction identifier="mcj_spear_boost"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="MeleeAttackSpeed" value="0.10" />
      <StatValue stattype="RangedAttackSpeed" value="0.05" />
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="1,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <!-- ===== 放浪神之箭：全队移动速度与游泳速度 ===== -->
  <Affliction identifier="mcj_arrow"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- WalkingSpeed / SwimmingSpeed 就是原版两个速度基因用的 stat。
         原版参照：增加行走速度基因 0.10~0.25 / 增加游泳速度基因 0.10~0.50 -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="WalkingSpeed" value="0.15" />
      <StatValue stattype="SwimmingSpeed" value="0.20" />
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="2,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <Affliction identifier="mcj_arrow_boost"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="WalkingSpeed" value="0.05" />
      <StatValue stattype="SwimmingSpeed" value="0.10" />
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="2,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <!-- ===== 世界树之干：全队伤害抗性 ===== -->
  <Affliction identifier="mcj_bole"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 原版参照：伤害抗性基因 0.10~0.25 -->
    <Effect minstrength="0" maxstrength="1"
            strengthchange="0"
            resistancefor="damage"
            minresistance="0.15"
            maxresistance="0.15" />
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="3,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <Affliction identifier="mcj_bole_boost"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1"
            strengthchange="0"
            resistancefor="damage"
            minresistance="0.05"
            maxresistance="0.05" />
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="3,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <!-- ===== 建筑神之塔：全队修理速度与修船壳速度 ===== -->
  <Affliction identifier="mcj_spire"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- RepairSpeed = 通用修理速度（机械 + 电器一起覆盖）
         RepairToolStructureRepairMultiplier = 修船壳速度
         原版参照：工程师天赋 stationengineer 为 0.50 / 0.50 -->
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="RepairSpeed" value="0.20" />
      <StatValue stattype="RepairToolStructureRepairMultiplier" value="0.20" />
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="4,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <Affliction identifier="mcj_spire_boost"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1">
      <StatValue stattype="RepairSpeed" value="0.10" />
      <StatValue stattype="RepairToolStructureRepairMultiplier" value="0.10" />
    </Effect>
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="4,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <!-- ===== 河流神之瓶：全队氧气消耗 ===== -->
  <Affliction identifier="mcj_ewer"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 原版参照：减氧消耗基因 0.20~1.00 -->
    <Effect minstrength="0" maxstrength="1"
            strengthchange="0"
            resistancefor="oxygenlow"
            minresistance="0.20"
            maxresistance="0.20" />
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="5,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

  <Affliction identifier="mcj_ewer_boost"
              type="talentbuff"
              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              resetbetweenrounds="true"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <Effect minstrength="0" maxstrength="1"
            strengthchange="0"
            resistancefor="oxygenlow"
            minresistance="0.10"
            maxresistance="0.10" />
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="5,0" sheetelementsize="128,128" color="10,193,114,255" origin="0,0" />
  </Affliction>

</Afflictions>
