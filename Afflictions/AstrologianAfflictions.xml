              isbuff="true"
              hideiconafterdelay="true"
              limbspecific="false"
              maxstrength="1"
              duration="15"
              treatmentthreshold="1000"
              iconcolors="33,75,78;126,211,224;126,211,224;227,247,249">
    <!-- 对标 TE：`easyturtle` 0.2 / `stonewall` 0.2→0.4。原版 resistancefor="damage" 上限 0.5。
         ⚠️ 当前仍是【旧的常驻版数值】，档位待 15 秒版本实测后再定 -->
    <Effect minstrength="0" maxstrength="1"
